  // ---------- Live the Day: real continuous recording + live speech-to-text ----------
  // Two things run side by side while "recording": a MediaRecorder capturing the
  // actual audio at a low, speech-only bitrate (kept on-device, downloadable when
  // you stop), and — in Chrome — the browser's built-in SpeechRecognition turning
  // speech into text live. That text is what gets scanned for achievements,
  // anecdotal moments, and quiet stretches. Neither pipeline is real NLP: the
  // "detection" below is a plain keyword matcher, on purpose kept simple and
  // visible rather than pretending to understand the lesson.
  const RECORD_AUDIO_BITRATE = 24000; // ~24 kbps mono-ish — small files, still intelligible speech
  const QUIET_THRESHOLD_MS = 5 * 60 * 1000; // 5+ minutes with no detected speech = a flagged quiet stretch
  let bigStream = null;
  let bigRecorder = null;
  let bigAudioChunks = [];
  let bigRecognition = null;
  const recognitionSupported = !!(window.SpeechRecognition || window.webkitSpeechRecognition);
  let lastSpeechAt = 0;
  let quietSince = null;
  let idleWatcherInterval = null;

  function setRecStatus(text, live){
