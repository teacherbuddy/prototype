    }
  }
  function skipAfterHours(){
    stopDictation();
    saveAfterHours({ answer: '', entries: [], done: true, skipped: true, at: stampNow() });
    renderAfterHours();
  }
  function reopenAfterHours(){
    const w = loadWeekData();
    const ah = getAfterHours(w);
    saveAfterHours({ done: false });
