        const info = document.createElement('div');
        info.className = 'tag-info';
        info.innerHTML = '<strong>' + escapeHtml(sg.start || '?') + '–' + escapeHtml(sg.end || '?') + '</strong> <span>' + escapeHtml(sg.kind || '') + '</span>' +
          (sg.edited ? ' <span class="tag-src">you changed this</span>' : ' <span class="tag-src ai">AI suggestion</span>');
