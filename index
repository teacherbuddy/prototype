  function updateAfterHoursEntry(i, minutes){
    const w = loadWeekData(); const ah = getAfterHours(w); if (!ah || !ah.entries[i]) return;
    ah.entries[i].minutes = Math.max(0, Math.min(1440, Math.round(Number(minutes) || 0)));
