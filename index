  // Pairs a Start/Stop Recording click into one entry on day.recordingSessions —
  // a day can have more than one session if the teacher pauses and resumes
  // (e.g. over a break), so this is an array, not a single start/stop pair.
  function logRecordingSession(day, startStamp, stopStamp){
    if (!startStamp || !stopStamp) return;
