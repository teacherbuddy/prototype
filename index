  // ---------- v4.4: English-only lock + transcript filter ----------
  // The browser's recognizer always tries to turn sound into words in the language
  // it is told to expect, so noise or a nearby speaker can come out as Spanish-looking
  // or nonsense text. It cannot be told to skip other languages, so lines are checked
  // after the fact. Hidden lines are kept in a log, never silently deleted.
  const RECOG_LANG = 'en-US';          // fixed on purpose: English only
  const MIN_CONFIDENCE = 0.6;          // lines scoring below this are hidden (0 = not reported, so not judged)
  const SPANISH_WORDS = new Set(['el','los','las','que','qué','por','para','pero','entonces','iba','entré','entraste','enteré','estoy','estás','está','muy','cómo','porque','cuando','donde','hay','vamos','bueno','gracias','hola','una','con','del','nos','esto','eso','pues','también','tengo','tiene']);
  const OTHER_WORDS = new Set(['yang','dan','tidak','itu','ini','kamu','saya','aku','ada','dengan','untuk','dari','ke','di','apa','kita','mereka','sudah','belum','tolong','ayo','duduk','bagus','jangan','bisa','mau','sama','juga','nggak','gak','kok','sih','dong']);
  function languageProblem(text){
    if (/[ñáéíóúü¿¡]/i.test(text)) return 'accented non-English characters';
    const words = text.toLowerCase().replace(/[^a-zñáéíóúü'\s]/g,' ').split(/\s+/).filter(Boolean);
    if (words.length >= 3){
      const es = words.filter(x => SPANISH_WORDS.has(x)).length;
      if (es >= 3 && es / words.length >= 0.4) return 'looks like Spanish';
      const id = words.filter(x => OTHER_WORDS.has(x)).length;
      if (id >= 3 && id / words.length >= 0.4) return 'looks non-English';
    }
    return null;
  }
  // Returns null if the line is fine, otherwise a short reason it should be hidden.
  function hiddenReason(text, confidence){
    if (typeof confidence === 'number' && confidence > 0 && confidence < MIN_CONFIDENCE) return 'low confidence';
    return languageProblem(text);
  }

  // v4.4: a more forgiving keyword matcher. Still plain pattern matching, not real
  // understanding. It matches word stems, ignores punctuation, and tolerates the
  // small grammar slips and filler words common in spoken English ("good job for
  // you", "please you settle down", "projector not work again").
  function classifyUtterance(text){
    const t = text.toLowerCase().replace(/[^a-z0-9\s']/g, ' ').replace(/\s+/g, ' ').trim();
    const hits = [];
    if (/\b(great|good|nice|fantastic|excellent|wonderful|amazing|awesome) (job|work|answer|thinking|idea|effort|try)\b|\b(great|good|excellent),? (your|that'?s a|that is a) (answer|idea|work)\b|\bwell done\b|\bexcellent\b|\bway to go\b|\bvery good\b|\b(i'?m|i am|i) (really |so |very )?proud\b|\bproud of (you|them|everyone|all)\b|\bthank you (for|already)\b|\bgive (yourselves?|him|her|them) a (clap|hand)\b/.test(t)){
      // v4.3: praising a student is not the teacher's own achievement, so it is
      // logged as an anecdote. Her achievements come from the day summary.
      hits.push({ type: 'anecdote', label: 'Praise for a student' });
    }
    if (/\b(settle( down)?|eyes on me|look at me|quiet (please|down)|be quiet|keep quiet|stop (talking|doing|to do)|inside voices?|focus please|let'?s refocus|volume down|sit (down|nicely|properly)|listen (to|your|carefully)|(raise|put up) (the|your) hands?|don'?t (be )?noisy|no (talking|noise))\b/.test(t)){
      hits.push({ type: 'anecdote', label: 'Classroom management moment' });
    }
    if (/\b(let'?s (move on|start|begin)|(we|okay we|ok we) (move|start) (on|now|our)|now we\b|next,? we\b|take out your|turn to (the )?page|open your (book|books|notebook|notebooks)( to| on)?|put (away )?your|put away|time (to|for) (clean|tidy)|start our lesson)\b/.test(t)){
      hits.push({ type: 'anecdote', label: 'Lesson transition' });
    }
    // Two soft, low-priority anecdote categories — genuinely ambiguous on their own,
    // so they sit quietly in Anecdotal records rather than asking for a follow-up.
    if (/\b(hang on|hold on|just a (moment|minute|sec|second)|one (moment|minute|sec|second)|give me a (moment|minute|sec|second)|wait a (moment|minute|sec|second|while)|please wait)\b/.test(t)){
      hits.push({ type: 'anecdote', label: 'Possible pacing pause' });
    }
    if (/\b(do you need (any )?help|you need (any )?help|need (any )?help (with|for|on) (that|this)( one)?|are you (okay|alright|ok)|you are (okay|alright|ok)\b)/.test(t)){
      hits.push({ type: 'anecdote', label: 'Individual check-in' });
    }
    // Two higher-priority categories: these get their own "Needs a follow-up"
    // card and trigger a Reflection prompt.
    const tool = '(projector|smartboard|smart board|computer|laptop|printer|wifi|wi fi|internet|speaker|microphone|chromebook|ipad|tablet|screen)';
    const bad  = '(not working|not work|isn\'?t working|isn\'?t work|doesn\'?t work|won\'?t work|won\'?t turn on|not turn on|is down|not down|is broken|broken|stopped working|frozen|crashed|won\'?t connect|not connect|not connecting|not loading|not load)';
    if (new RegExp('\\b' + tool + '\\b(?:\\s+\\w+){0,4}?\\s+' + bad + '\\b').test(t)){
      hits.push({ type: 'incident', label: 'Tool / technical trouble' });
    }
    if (/\b(stop|don'?t|no) fight(ing)?\b|\bthey'?re fighting\b|\bbreak it up\b|\bhands? to (yourself|yourselves)\b|\bkeep your hands? to yourself\b|\bstop (hitting|pushing|shoving)\b|\bget off (him|her|them)\b|\bknock it off\b|\bthat'?s not okay to (hit|push)\b/.test(t)){
      hits.push({ type: 'incident', label: 'Possible student conflict' });
    }
    return hits;
  }

  // "Needs a follow-up" incidents are handled two different ways depending on
  // the label, because not every kind of flagged moment means the same thing
  // when it repeats:
  //  - A possible student conflict is NOT clustered, ever. Each one is kept as
  //    its own distinct incident and always asks for its own explanation — two
  //    conflicts in one day may well be two different students or situations,
  //    and folding them together would lose exactly the texture that matters
  //    most for this category.
  //  - Tool / technical trouble IS clustered: every occurrence on a given day
  //    rolls into one shared entry (inc.clustered, inc.occurrenceCount,
  //    inc.occurrences[]) instead of creating a new incident each time. That
  //    entry stays quiet — logged, but no "explain this" prompt — until it's
  //    happened PATTERN_THRESHOLD times in the day, at which point it becomes a
  //    single combined ask ("this kept happening — what's going on?"). Once
  //    answered, further same-day occurrences just keep incrementing the count
  //    silently; the question doesn't reopen.
  // Together, this is what replaced the old 10/day salience-ranked cap
  // (v3.20, same day): with clustering there's at most one "needs a reply"
  // entry per label per day, so there's nothing left to ration.
  const PATTERN_THRESHOLD = 5;
  const CLUSTERABLE_LABELS = ['Tool / technical trouble'];

  function appendTranscript(text, isFinal){
    const box = document.getElementById('liveTranscriptBox');
    if (!box) return;
    const emptyEl = document.getElementById('transcriptEmptyState');
    if (emptyEl) emptyEl.remove();
    let interimEl = document.getElementById('transcriptInterim');
    if (isFinal){
      if (interimEl) interimEl.remove();
      const span = document.createElement('span');
      span.textContent = text + ' ';
      box.appendChild(span);
    } else {
      if (!interimEl){
        interimEl = document.createElement('span');
        interimEl.id = 'transcriptInterim';
        interimEl.className = 'interim';
        box.appendChild(interimEl);
      }
      interimEl.textContent = text;
    }
    box.scrollTop = box.scrollHeight;
  }

  function renderAutoItem(containerId, item, kind){
    const row = document.createElement('div');
    row.className = 'auto-item ' + kind;
    row.innerHTML = '<span class="dot"></span>' +
      '<div class="body"><div>' + escapeHtml(item.label) + (item.text ? ': "' + escapeHtml(item.text) + '"' : '') + '</div>' +
      '<div class="meta">' + escapeHtml(item.at) + ' · auto-flagged</div></div>' +
      '<button class="remove-btn" title="Remove">✕</button>';
    row.querySelector('.remove-btn').onclick = () => row.remove();
    document.getElementById(containerId).appendChild(row);
  }
  function renderIdleItem(entry, idx){
    const row = document.createElement('div');
    row.className = 'idle-item';
    const txt = document.createElement('span');
    txt.innerHTML = 'Quiet stretch ending around ' + escapeHtml(entry.at) + ' <span class="dur">~' + entry.minutes + ' min</span>';
    row.appendChild(txt);
    const tagEl = document.createElement('span');
    tagEl.className = 'dur';
    tagEl.textContent = entry.tag ? tagLabel(entry.tag) : 'Tag at Day\'s End';
    row.appendChild(tagEl);
    document.getElementById('idleBody').appendChild(row);
  }

  // "Needs a follow-up" items (tool/tech trouble, possible student conflicts) are
  // higher-priority than routine anecdotes: each one also queues a Reflection
  // prompt (queueFollowUpPrompt) asking the teacher to explain what happened,
  // and shows a pending/answered state here until they do.
  function renderIncidentItem(entry){
    const existing = document.getElementById('incidentRow-' + entry.id);
    if (existing) existing.remove();
    const row = document.createElement('div');
    row.className = 'incident-item';
    row.id = 'incidentRow-' + entry.id;
    const occurrenceNote = (entry.clustered && entry.occurrenceCount > 1) ? ' · noticed ' + entry.occurrenceCount + '× today' : '';
    let body = '<div class="inc-head"><span class="inc-dot"></span><div class="inc-body"><div>' +
      escapeHtml(entry.label) + (entry.text ? ': "' + escapeHtml(entry.text) + '"' : '') + '</div>' +
      '<div class="inc-meta">' + escapeHtml(entry.at) + ' · auto-flagged' + occurrenceNote + (incidentThompsonLabel(entry) ? ' · ' + escapeHtml(incidentThompsonLabel(entry)) : '') + '</div></div>' +
      '<button class="remove-btn" title="Remove">✕</button></div>';
    if (entry.context){
      let supportLine = '';
      if (entry.context.support === SELF_HANDLED_CATEGORY){
        supportLine = '<br><strong>✓ No support needed</strong> — handled independently';
      } else if (entry.context.support){
        supportLine = '<br><strong>Support that would help:</strong> ' + escapeHtml(SUPPORT_LABELS[entry.context.support] || entry.context.support);
      }
      body += '<div class="inc-context">Your explanation (' + escapeHtml(entry.context.source === 'voice' ? 'spoken, transcribed automatically' : 'typed') + '): "' + escapeHtml(entry.context.text) + '"' + supportLine + '</div>';
    } else if (entry.clustered && !entry.pattern){
      body += '<div class="inc-noreply">Noticed ' + entry.occurrenceCount + ' time' + (entry.occurrenceCount === 1 ? '' : 's') + ' today so far — not asking yet. If it keeps happening (' + PATTERN_THRESHOLD + '+ times in a day), TeacherBuddy will flag it as a pattern worth explaining.</div>';
    } else {
      const askText = (entry.clustered && entry.occurrenceCount > 1) ? 'This has now come up ' + entry.occurrenceCount + ' times today — waiting on your explanation' : 'Waiting on your explanation';
      body += '<div class="inc-pending">' + askText + ' — <button class="edit-link" onclick="setActiveFollowUp(\'' + entry.id + '\')">explain at Day\'s End →</button></div>';
    }
    row.innerHTML = body;
    row.querySelector('.remove-btn').onclick = () => {
      row.remove();
      const w = loadWeekData();
      w[currentDay].incidents = (w[currentDay].incidents || []).filter(i => i.id !== entry.id);
      saveWeekData(w);
      if (!w[currentDay].incidents.length){
        document.getElementById('incidentsBody').innerHTML = '<div class="empty-state" id="incidentsEmptyState">Nothing flagged yet. TeacherBuddy listens for things like tool or tech trouble and possible student conflicts, and will ask you to explain what happened over in Reflection.</div>';
      }
      updateReflectionBadge();
    };
    document.getElementById('incidentsBody').appendChild(row);
  }

  function logIncident(day, label, text){
    const w = loadWeekData();
    const now = Date.now();
    const list = w[day].incidents || [];
    const stamp = stampNow();
    const clusterable = CLUSTERABLE_LABELS.includes(label);

    let entry;
    let justBecamePattern = false;

    if (clusterable){
      // One shared entry per label per day — a new occurrence adds to the
      // existing cluster instead of creating a fresh incident every time.
      const cluster = list.find(i => i.label === label && i.clustered);
      if (cluster){
        cluster.occurrenceCount = (cluster.occurrenceCount || 1) + 1;
        cluster.occurrences = cluster.occurrences || [];
        cluster.occurrences.push({ text, at: stamp, ts: now });
        cluster.text = text;
        cluster.at = stamp;
        cluster.ts = now;
        const wasPattern = cluster.pattern;
        cluster.pattern = cluster.occurrenceCount >= PATTERN_THRESHOLD;
        if (!wasPattern && cluster.pattern) justBecamePattern = true;
        entry = cluster;
      } else {
        entry = {
          id: 'inc-' + now + '-' + Math.random().toString(36).slice(2, 7),
          label, text, at: stamp, ts: now, context: null,
          clustered: true, occurrenceCount: 1, occurrences: [{ text, at: stamp, ts: now }],
          pattern: 1 >= PATTERN_THRESHOLD
        };
        if (entry.pattern) justBecamePattern = true;
        list.push(entry);
      }
    } else {
      // Not clusterable: every occurrence is its own distinct incident and
      // always asks for its own explanation, same as before clustering existed.
      entry = { id: 'inc-' + now + '-' + Math.random().toString(36).slice(2, 7), label, text, at: stamp, ts: now, context: null };
      list.push(entry);
      justBecamePattern = true;
    }

    w[day].incidents = list;
    saveWeekData(w);

    if (day === currentDay){
      const emptyEl = document.getElementById('incidentsEmptyState');
      if (emptyEl) emptyEl.remove();
      renderIncidentItem(entry);
      // Only fire (or re-fire) the chat prompt the moment this entry actually
      // becomes something that needs a reply — not on every quiet increment
      // below the pattern threshold, and not again once it's already been
      // asked about and answered once.
      if (justBecamePattern && !entry.context) queueFollowUpPrompt(entry);
      updateReflectionBadge();
    }
  }

  // Which incident the next reply should attach to — set ONLY by an explicit
  // "explain this" click (on the incident row or the chat prompt itself), never
  // guessed from reply order. Two flagged moments can land back-to-back before
  // the teacher answers either one, so matching "whichever is oldest unanswered"
  // risks attaching the wrong explanation to the wrong moment — explicit beats
  // implicit here.
  let activeFollowUpId = null;
  let activeFollowUpSupport = null;
  function setActiveFollowUp(id){
    const w = loadWeekData();
    const inc = (w[currentDay].incidents || []).find(i => i.id === id);
    if (!inc) return;
    activeFollowUpId = id;
    activeFollowUpSupport = null;
    selectTab('reflection');
    const banner = document.getElementById('activeFollowUpBanner');
    banner.querySelector('.text').textContent = 'Replying to: ' + inc.label + (inc.text ? ' ("' + inc.text + '")' : '');
    banner.hidden = false;
    const chipRow = document.getElementById('supportChipRow');
    if (chipRow){
      chipRow.hidden = false;
      chipRow.querySelectorAll('.chip-btn').forEach(c => c.classList.remove('primary'));
      // Pre-highlight a starting suggestion based on the incident's own type
      // (see SUPPORT_SUGGESTION_BY_LABEL) — the teacher can change or clear it.
      const suggested = SUPPORT_SUGGESTION_BY_LABEL[inc.label];
      if (suggested){
        const suggestedBtn = chipRow.querySelector('.chip-btn[data-cat="' + suggested + '"]');
        if (suggestedBtn){
          suggestedBtn.classList.add('primary');
          activeFollowUpSupport = suggested;
        }
      }
    }
    // Open the reply box right away — previously the teacher had to separately
    // find and click "Type a reply" after tapping "Explain this", with nothing
    // on screen showing where to actually type the explanation.
    const dialog = document.getElementById('typingDialog');
    if (dialog){
      dialog.classList.add('show');
      const textarea = dialog.querySelector('textarea');
      if (textarea) setTimeout(() => textarea.focus(), 50);
    }
  }
  function clearActiveFollowUp(){
    activeFollowUpId = null;
    activeFollowUpSupport = null;
    const banner = document.getElementById('activeFollowUpBanner');
    if (banner) banner.hidden = true;
    const chipRow = document.getElementById('supportChipRow');
    if (chipRow){
      chipRow.hidden = true;
      chipRow.querySelectorAll('.chip-btn').forEach(c => c.classList.remove('primary'));
    }
    const dialog = document.getElementById('typingDialog');
    if (dialog) dialog.classList.remove('show');
  }
  // Clicking an already-selected chip deselects it (the tag is optional —
  // there's no requirement to pick one to submit an explanation).
  function selectSupportCategory(cat, btn){
    const chipRow = document.getElementById('supportChipRow');
    const alreadySelected = btn.classList.contains('primary');
    chipRow.querySelectorAll('.chip-btn').forEach(c => c.classList.remove('primary'));
    if (alreadySelected){
      activeFollowUpSupport = null;
    } else {
      btn.classList.add('primary');
      activeFollowUpSupport = cat;
    }
  }
  // True once an incident actually needs a reply: for a clustered entry
  // that's "reached the pattern threshold and hasn't been answered yet"; for
  // a non-clustered one (every occurrence is its own incident) it's simply
  // "hasn't been answered yet."
  function incidentNeedsReply(inc){
    if (inc.clustered) return !!inc.pattern && !inc.context;
    return !inc.context;
  }
  function hasPendingIncident(){
    const w = loadWeekData();
    return (w[currentDay].incidents || []).some(incidentNeedsReply);
  }
  function updateReflectionBadge(){
    const badge = document.getElementById('reflectionBadge');
    if (!badge) return;
    badge.hidden = !hasPendingIncident();
  }
  // Builds the bot "I caught something... can you explain?" bubble for one
  // incident, without appending or touching anything else — shared by the
  // live queueFollowUpPrompt() (fires the moment an incident is flagged
  // while recording) and rebuildCheckinChat() (reconstructs the whole chat
  // from saved data on load/refresh/day-switch, since these bubbles were
  // previously pure, unsaved DOM state that vanished on any reload).
  function buildBotFollowUpBubble(entry, stampText){
    const bubble = document.createElement('div');
    bubble.className = 'bubble bot';
    const what = entry.label === 'Possible student conflict' ? 'a possible conflict between students' : 'tool or tech trouble';
    const span = document.createElement('span');
    if (entry.clustered && entry.occurrenceCount > 1){
      span.textContent = 'I noticed ' + what + ' come up ' + entry.occurrenceCount + ' times today' +
        (entry.text ? (', most recently: "' + entry.text + '"') : '') + '. Since it kept happening, can you tell me what\'s been going on?';
    } else {
      span.textContent = 'I caught something that sounded like ' + what + ' around ' + entry.at +
        (entry.text ? (' ("' + entry.text + '")') : '') + '. Can you tell me what actually happened?';
    }
    bubble.appendChild(span);
    bubble.appendChild(document.createElement('br'));
    const answerBtn = document.createElement('button');
    answerBtn.className = 'chip-btn';
    answerBtn.style.marginTop = '8px';
    answerBtn.textContent = 'Explain this →';
    answerBtn.onclick = () => setActiveFollowUp(entry.id);
    bubble.appendChild(answerBtn);
    const stamp = document.createElement('span');
    stamp.className = 'stamp';
    stamp.textContent = 'TeacherBuddy · ' + (stampText || stampNow());
    bubble.appendChild(stamp);
    return bubble;
  }
  // Builds a "me" (teacher) reply bubble — shared by the live sendTypedReply()
  // and rebuildCheckinChat()'s reconstruction of saved replies.
  function buildMeBubble(text, atLabel){
    const bubble = document.createElement('div');
    bubble.className = 'bubble me';
    const span = document.createElement('span');
    span.textContent = text;
    bubble.appendChild(span);
    const stamp = document.createElement('span');
    stamp.className = 'stamp';
    stamp.textContent = 'You · ' + (atLabel || stampNow());
    bubble.appendChild(stamp);
    return bubble;
  }
  function queueFollowUpPrompt(entry){
    clearCheckinEmptyState();
    document.getElementById('checkinChat').appendChild(buildBotFollowUpBubble(entry));
    updateReflectionBadge();
  }
  // Rebuilds the whole "TeacherBuddy checked in" chat from this day's saved
  // data — every flagged incident's bot prompt (answered or not), its reply
  // if one was given, and any other written reflection not tied to a
  // specific incident. Previously this chat only ever existed as DOM
  // elements appended live during the session, with nothing persisted, so a
  // refresh (or just switching days and back) silently wiped it — including
  // follow-up prompts the teacher hadn't answered yet. The underlying data
  // (day.incidents, day.replies) was always saved correctly; only this
  // on-screen chat history wasn't being reconstructed from it.
  function rebuildCheckinChat(day){
    const chat = document.getElementById('checkinChat');
    if (!chat) return;
    chat.innerHTML = '';
    const w = loadWeekData();
    const incidents = w[day].incidents || [];
    const replies = w[day].replies || [];
    const consumed = new Array(replies.length).fill(false);

    incidents.forEach(entry => {
      if (entry.clustered && !entry.pattern) return; // hasn't crossed the pattern threshold — never asked, nothing to show
      chat.appendChild(buildBotFollowUpBubble(entry, entry.at));
      if (entry.context && entry.context.text){
        chat.appendChild(buildMeBubble(entry.context.text, entry.context.at));
        // The same text was also logged into day.replies when it was sent
        // (sendTypedReply logs every reply, incident-answering or not) —
        // mark that entry consumed so it isn't shown again as a duplicate
        // standalone bubble below.
        const idx = replies.findIndex((r, i) => !consumed[i] && r.text === entry.context.text);
        if (idx !== -1) consumed[idx] = true;
      }
    });
    replies.forEach((r, i) => {
      if (!consumed[i]) chat.appendChild(buildMeBubble(r.text, r.at));
    });

    if (!chat.children.length){
      const empty = document.createElement('div');
      empty.className = 'empty-state';
      empty.id = 'checkinEmptyState';
      empty.textContent = 'Nothing flagged today.';
      chat.appendChild(empty);
    }
  }
  function resolveFollowUp(id, contextText, source, supportCategory){
    const w = loadWeekData();
    const inc = (w[currentDay].incidents || []).find(i => i.id === id);
    if (!inc) return;
    inc.context = { text: contextText, source, at: stampNow(), support: supportCategory || null };
    saveWeekData(w);
    renderIncidentItem(inc);
    updateReflectionBadge();
  }

  function logAchievement(day, label, text){
    const w = loadWeekData();
    const entry = { label, text, at: stampNow() };
    w[day].achievements.push(entry);
    saveWeekData(w);
    // v4.5: the live Achievements card is gone; older saved items still count in
    // the weekly summary and appear in the day PDF.
  }
  function logAnecdote(day, label, text){
    const w = loadWeekData();
    const entry = { label, text, at: stampNow() };
    w[day].anecdotes.push(entry);
    saveWeekData(w);
    if (day === currentDay){
      const emptyEl = document.getElementById('anecdotesEmptyState');
      if (emptyEl) emptyEl.remove();
      renderAutoItem('anecdotesBody', entry, 'anecdote');
    }
  }
  function logIdleStretch(day, minutes){
    const w = loadWeekData();
    const entry = { minutes, at: stampNow(), tag: null };
    w[day].idleStretches.push(entry);
    saveWeekData(w);
    if (day === currentDay){
      const emptyEl = document.getElementById('idleEmptyState');
      if (emptyEl) emptyEl.remove();
      renderIdleItem(entry, w[day].idleStretches.length - 1);
      renderTimeTags();
    }
  }

  // Rebuilds the Achievements / Anecdotal records / Idle time cards for
  // whichever day is current — called on every day switch. The live transcript
  // box is session-only (like the voice-note audio elsewhere in this
  // prototype) and isn't persisted, so it resets when you switch days.
  function renderDailyPanels(){
    const w = loadWeekData();
    const day = w[currentDay];

    const incBody = document.getElementById('incidentsBody');
    incBody.innerHTML = day.incidents.length ? '' :
      '<div class="empty-state" id="incidentsEmptyState">Nothing flagged yet. TeacherBuddy listens for things like tool or tech trouble and possible student conflicts, and will ask you to explain what happened over in Reflection.</div>';
    day.incidents.forEach(e => renderIncidentItem(e));
    updateReflectionBadge();
    clearActiveFollowUp(); // a pending target from another day shouldn't carry over
    rebuildCheckinChat(currentDay);
    renderAiSummary(currentDay);
    stopDictation();
    renderTimeTags();
    renderTeaching();
    renderStress();
    renderGuided();

    const anecBody = document.getElementById('anecdotesBody');
    anecBody.innerHTML = day.anecdotes.length ? '' :
      '<div class="empty-state" id="anecdotesEmptyState">No anecdotal records yet today. TeacherBuddy flags classroom-management moments, lesson transitions, possible pacing pauses, and individual check-ins it catches in the transcript — these are simple keyword matches, not real understanding, so correct or remove anything inaccurate.</div>';
    day.anecdotes.forEach(e => renderAutoItem('anecdotesBody', e, 'anecdote'));

    renderIdleList();

    const box = document.getElementById('liveTranscriptBox');
    if (box){
      box.innerHTML = '';
      if (day.transcript && day.transcript.length){
        // Rehydrate from what's already saved for this day (every finalized
        // line is persisted as it's spoken — see logTranscriptLine) so a
        // refresh or a return visit to Live the Day shows the real transcript
        // instead of wiping it back to the empty-state placeholder.
        day.transcript.forEach(line => {
          const span = document.createElement('span');
          span.textContent = (line && line.text ? line.text : '') + ' ';
          box.appendChild(span);
        });
      } else {
        const span = document.createElement('span');
        span.className = 'empty-state';
        span.id = 'transcriptEmptyState';
        span.style.padding = '0';
        span.textContent = 'Nothing transcribed yet this session. Start recording to see live text appear here as you speak — this works in Chrome; other browsers will record audio only, with no live transcript.';
        box.appendChild(span);
      }
    }
    const errEl = document.getElementById('bigRecordError');
    if (errEl) errEl.hidden = true;
    const statusLine = document.getElementById('recStatusLine');
    if (statusLine) statusLine.hidden = true;
  }

  // v4.1: every silence of 2+ minutes is saved (not just the 5+ minute ones
  // shown on Live the Day), with exact start/end times, so "Read my day" can
  // later join two gaps that were split by a brief interruption ("Hi, Sarah!").
  const QUIET_GAP_MIN_MS = 2 * 60 * 1000;
  function stampAt(ts){
    try { return new Date(ts).toLocaleTimeString('en-US', { timeZone: DISPLAY_TIMEZONE, hour: 'numeric', minute: '2-digit', hour12: true }); }
    catch (e){ return stampNow(); }
  }
  function logQuietGap(day, startTs, endTs){
    if (!day || !startTs || !endTs || endTs - startTs < QUIET_GAP_MIN_MS) return;
    const w = loadWeekData();
    if (!w[day]) return;
    w[day].quietGaps.push({ startTs, endTs, startAt: stampAt(startTs), endAt: stampAt(endTs), minutes: Math.round((endTs - startTs) / 6000) / 10 });
    saveWeekData(w);
  }
  function noteSpeechActivity(){
    const nowTs = Date.now();
    if (bigRecording && lastSpeechAt && nowTs - lastSpeechAt >= QUIET_GAP_MIN_MS) logQuietGap(bigRecordDay || currentDay, lastSpeechAt, nowTs);
    if (quietSince !== null){
      const minutes = Math.round((Date.now() - quietSince) / 60000);
      if (minutes >= 5) logIdleStretch(currentDay, minutes);
      quietSince = null;
    }
    lastSpeechAt = Date.now();
  }
  function startIdleWatcher(){
    lastSpeechAt = Date.now();
    quietSince = null;
    idleWatcherInterval = setInterval(() => {
      if (!bigRecording) return;
      if (Date.now() - lastSpeechAt >= QUIET_THRESHOLD_MS && quietSince === null){
        quietSince = lastSpeechAt;
      }
    }, 15000);
  }
  function stopIdleWatcher(closeOpenStretch){
    clearInterval(idleWatcherInterval);
    idleWatcherInterval = null;
    if (closeOpenStretch && lastSpeechAt) logQuietGap(bigRecordDay || currentDay, lastSpeechAt, Date.now());
    if (closeOpenStretch && quietSince !== null){
      const minutes = Math.round((Date.now() - quietSince) / 60000);
      if (minutes >= 5) logIdleStretch(currentDay, minutes);
    }
    quietSince = null;
  }

  function startRecognition(){
    const SR = window.SpeechRecognition || window.webkitSpeechRecognition;
    if (!SR) return;
    const recog = new SR();
    recog.continuous = true;
    recog.interimResults = true;
    recog.lang = RECOG_LANG;
    recog.onresult = (event) => {
      noteSpeechActivity();
      let interim = '';
      for (let i = event.resultIndex; i < event.results.length; i++){
        const res = event.results[i];
        const text = res[0].transcript.trim();
        if (res.isFinal){
          const why = text ? hiddenReason(text, res[0].confidence) : null;
          if (text && why){
            // v4.4: not shown, not tagged, not sent to the AI — kept in a hidden log
            logHiddenLine(currentDay, text, why, res[0].confidence);
          } else if (text){
            appendTranscript(text, true);
            logTranscriptLine(currentDay, text);
            classifyUtterance(text).forEach(hit => {
              if (hit.type === 'achievement') logAchievement(currentDay, hit.label, text);
              else if (hit.type === 'incident') logIncident(currentDay, hit.label, text);
              else logAnecdote(currentDay, hit.label, text);
            });
          }
        } else {
          if (!languageProblem(text)) interim += text + ' ';
        }
      }
      if (interim.trim()) appendTranscript(interim.trim(), false);
    };
    recog.onerror = (event) => {
      if (event.error === 'not-allowed' || event.error === 'service-not-allowed'){
        setRecStatus('Live transcription was blocked — continuing with audio-only recording.', false);
      } else if (event.error === 'network'){
        setRecStatus('Transcription lost its connection — retrying…', false);
      }
      // 'no-speech' and similar are benign; recognition ends and restarts on its own below.
    };
    recog.onend = () => {
      if (bigRecording && bigRecognition === recog){
        // Browsers stop SpeechRecognition after silence or an internal time limit —
        // restart it transparently so an 8-hour day keeps getting transcribed.
        try { recog.start(); setRecStatus('Listening…', true); }
        catch (e){ setTimeout(() => { if (bigRecording && bigRecognition === recog){ try { recog.start(); } catch (e2){ /* give up quietly; audio recording continues regardless */ } } }, 500); }
      }
    };
    bigRecognition = recog;
    try {
      recog.start();
      setRecStatus('Listening…', true);
    } catch (e){ /* ignore — start() can throw if called in rapid succession */ }
  }
  function stopRecognition(){
    if (bigRecognition){
      const recog = bigRecognition;
      bigRecognition = null; // clear first so onend above doesn't try to restart it
      recog.onend = null;
      try { recog.stop(); } catch (e){ /* already stopped */ }
    }
  }

  async function toggleBigRecording(){
    const btn = document.getElementById('bigRecordBtn');
    const label = document.getElementById('bigRecordLabel');
    const dot = document.getElementById('bigRecordDot');
    const timer = document.getElementById('bigRecordTimer');
    const errEl = document.getElementById('bigRecordError');
    errEl.hidden = true;

    if (!bigRecording){
      btn.disabled = true;
      label.textContent = 'Requesting microphone…';
      const stream = await getMic('bigRecordError');
      btn.disabled = false;
      if (!stream){ label.textContent = 'Start Recording'; return; }
      bigStream = stream;
      bigAudioChunks = [];

      try {
        bigRecorder = new MediaRecorder(stream, { audioBitsPerSecond: RECORD_AUDIO_BITRATE });
      } catch (e){
        try { bigRecorder = new MediaRecorder(stream); }
        catch (e2){
          errEl.textContent = 'Your browser couldn\'t start a recorder (' + (e2 && e2.name ? e2.name : 'error') + ').';
          errEl.hidden = false;
          stream.getTracks().forEach(t => t.stop());
          label.textContent = 'Start Recording';
          return;
        }
      }
      bigRecorder.ondataavailable = e => { if (e.data && e.data.size > 0) bigAudioChunks.push(e.data); };
      bigRecorder.onstop = () => {
        bigStream.getTracks().forEach(t => t.stop());
        if (!bigAudioChunks.length) return;
        const blob = new Blob(bigAudioChunks, { type: bigRecorder.mimeType || 'audio/webm' });
        const url = URL.createObjectURL(blob);
        const sizeMb = (blob.size / (1024 * 1024)).toFixed(1);
        const dl = document.createElement('a');
        dl.href = url;
        dl.download = 'teacherbuddy-' + currentDay + '-' + Date.now() + '.webm';
        dl.textContent = 'Download today\'s audio (~' + sizeMb + ' MB)';
        dl.style.cssText = 'margin-left:10px; font-weight:700; color:var(--accent);';
        document.getElementById('recStatusLine').appendChild(dl);
      };
      bigRecorder.start(5000); // flush a chunk every 5s so memory holds compressed data, not one giant buffer

      bigRecording = true;
      bigRecordSeconds = 0;
      bigRecordSavedSeconds = 0;
      bigRecordDay = currentDay;
      bigRecordSessionStart = stampNow();
      label.textContent = 'Stop Recording';
      btn.classList.add('recording');
      dot.classList.add('active');
      timer.hidden = false;
      updateBigTimer();
      bigRecordInterval = setInterval(() => {
        bigRecordSeconds++;
        updateBigTimer();
        // Save as we go, so a refresh or closed tab doesn't lose the day's
        // recorded time (it used to be saved only on Stop).
        if (bigRecordSeconds - bigRecordSavedSeconds >= 30){
          logRecordedSeconds(bigRecordDay, bigRecordSeconds - bigRecordSavedSeconds);
          bigRecordSavedSeconds = bigRecordSeconds;
        }
      }, 1000);

      startIdleWatcher();
      if (recognitionSupported){
        startRecognition();
      } else {
        setRecStatus('Live transcription isn\'t available in this browser (Chrome is required) — recording audio only.', false);
      }
    } else {
      bigRecording = false;
      clearInterval(bigRecordInterval);
      label.textContent = 'Start Recording';
      btn.classList.remove('recording');
      dot.classList.remove('active');
      logRecordedSeconds(bigRecordDay || currentDay, bigRecordSeconds - bigRecordSavedSeconds);
      bigRecordSavedSeconds = bigRecordSeconds;
      const sessionStopStamp = stampNow();
      logRecordingSession(bigRecordDay || currentDay, bigRecordSessionStart, sessionStopStamp);

      stopRecognition();
      stopIdleWatcher(true);
      setRecStatus('Stopped — recorded ' + bigRecordSessionStart + ' to ' + sessionStopStamp + ' (' + tzLabel() + '). Preparing today\'s audio file…', false);
      bigRecordSessionStart = null;

      if (bigRecorder && bigRecorder.state !== 'inactive') bigRecorder.stop();
    }
  }

  // ---------- v4.0: Day's End guided reflection ----------
  // Order: questions (from the day summary, or three standard ones) answered by
  // voice or text, then at most ONE clarifying question, then a summary of the
  // reflection that the teacher rates. Claude reflects back only; feedback is
  // the coach's job. "Partly" / "missed it" ratings are flagged in the day PDF.
  const DEFAULT_QUESTIONS = [
    'What went well today, and what do you think made it work?',
    'What was the hardest moment today, and what was going on for you then?',
    'Is there anything you would do differently tomorrow?'
  ];
  const RATING_LABELS = { spot: 'Spot on', partly: 'Partly', missed: 'Missed it' };
  // v4.5: one last, skippable question before the summary. Her answer is shown
  // and printed as "added by the teacher", and is also read into the summary.
  const CLOSING_QUESTION = 'Before I sum up: is there anything you are proud of today, or anything that mattered that TeacherBuddy didn\'t capture?';
  function guidedQA(g){
    const qa = g.questions.map(x => ({ q: x.q, a: x.a ? x.a.text : '' }));
    if (g.closing && g.closing.a) qa.push({ q: g.closing.q, a: g.closing.a.text });
    return qa;
  }
  let guidedBusy = false;

  function guidedFor(day){
    if (day.guided && Array.isArray(day.guided.questions) && day.guided.questions.length) return day.guided;
    let qs = (day.aiSummary && Array.isArray(day.aiSummary.reflectionQuestions))
      ? day.aiSummary.reflectionQuestions.filter(q => typeof q === 'string' && q.trim()).slice(0, 3) : [];
    if (!qs.length) qs = DEFAULT_QUESTIONS.slice();
    return { questions: qs.map(q => ({ q, a: null })), clarifyChecked: false, clarify: null, summary: null };
  }
  function guidedPending(g){
    const qi = g.questions.findIndex(x => !x.a);
    if (qi !== -1) return { kind: 'question', index: qi, text: g.questions[qi].q };
    if (g.clarify && g.clarify.q && !g.clarify.a) return { kind: 'clarify', text: g.clarify.q };
    if (g.closing && !g.closing.a && !g.closing.skipped) return { kind: 'closing', text: g.closing.q };
    return null;
  }
  function botBubble(text, label){
    const b = document.createElement('div');
    b.className = 'bubble bot';
    const sp = document.createElement('span'); sp.textContent = text; b.appendChild(sp);
    const st = document.createElement('span'); st.className = 'stamp'; st.textContent = label || 'TeacherBuddy'; b.appendChild(st);
    return b;
  }
  function renderGuided(){
    const chat = document.getElementById('guidedChat');
    if (!chat) return;
    const w = loadWeekData();
    const day = w[currentDay];
    const g = guidedFor(day);
    chat.innerHTML = '';
    g.questions.forEach((x, i) => {
      if (!x.a && guidedPending(g) && guidedPending(g).index !== i) return;
      chat.appendChild(botBubble(x.q, 'TeacherBuddy · question ' + (i + 1) + ' of ' + g.questions.length));
      if (x.a) chat.appendChild(buildMeBubble(x.a.text, (x.a.source === 'voice' ? 'Spoken' : 'Typed') + ' · ' + x.a.at));
    });
    if (g.clarify && g.clarify.q){
      chat.appendChild(botBubble(g.clarify.q, 'TeacherBuddy · one clarifying question'));
      if (g.clarify.a) chat.appendChild(buildMeBubble(g.clarify.a.text, (g.clarify.a.source === 'voice' ? 'Spoken' : 'Typed') + ' · ' + g.clarify.a.at));
    }
    if (g.closing){
      chat.appendChild(botBubble(g.closing.q, 'TeacherBuddy · last question'));
      if (g.closing.a) chat.appendChild(buildMeBubble(g.closing.a.text, (g.closing.a.source === 'voice' ? 'Spoken' : 'Typed') + ' · ' + g.closing.a.at));
      else if (g.closing.skipped) chat.appendChild(buildMeBubble('Nothing to add today.', 'Skipped'));
    }
    const pending = guidedPending(g);
    const composer = document.getElementById('guidedComposer');
    composer.hidden = !pending || guidedBusy;
    document.getElementById('guidedComposerQ').textContent = pending
      ? (pending.kind === 'question' ? 'Your answer to question ' + (pending.index + 1) : pending.kind === 'closing' ? 'Your answer to the last question (or skip it)' : 'Your answer to the clarifying question') : '';
    document.getElementById('guidedSkipBtn').hidden = !(pending && pending.kind === 'closing');

    // Step 5
    const card = document.getElementById('reflectionSummaryCard');
    const sum = g.summary;
    card.hidden = !sum;
    if (sum){
      document.getElementById('reflectionSummaryText').textContent = sum.text;
      const addedBox = document.getElementById('closingAdded');
      const hasAdded = !!(g.closing && g.closing.a);
      addedBox.hidden = !hasAdded;
      document.getElementById('closingAddedText').textContent = hasAdded ? g.closing.a.text : '';
      document.querySelectorAll('#ratingRow .chip-btn').forEach(btn => btn.classList.toggle('primary', btn.dataset.rating === sum.rating));
      const editWrap = document.getElementById('ratingEditWrap');
      const flagged = sum.rating === 'partly' || sum.rating === 'missed';
      editWrap.hidden = !flagged || guidedBusy;
      const offerOpen = flagged && !sum.correctionDeclined && !correctionOpen;
      document.getElementById('clarifyOffer').hidden = !offerOpen;
      document.getElementById('correctionComposer').hidden = !(flagged && correctionOpen);
      document.getElementById('coachFlagNote').hidden = !(flagged && sum.correctionDeclined);
    }
    const done = !!day.reflectionSubmitted;
    document.getElementById('submitSuccess').classList.toggle('show', done);
    document.getElementById('toWeekBtn').hidden = !(currentDay === 'fri' && done);

    // If answers are all in but the flow stopped part-way (refresh, error),
    // offer to pick it up again rather than leaving the teacher stuck.
    const stalled = !pending && !sum && g.questions.every(x => x.a) && !guidedBusy;
    document.getElementById('guidedRetry').hidden = !stalled;
  }
  function sendGuidedAnswer(){
    const ta = document.getElementById('guidedAnswer');
    const text = ta.value.trim();
    if (!text || guidedBusy) return;
    const source = dictationUsed.guidedAnswer ? 'voice' : 'typed';
    stopDictation();
    dictationUsed.guidedAnswer = false;
    const w = loadWeekData();
    const day = w[currentDay];
    const g = guidedFor(day);
    const pending = guidedPending(g);
    if (!pending) return;
    const ans = { text, source, at: stampNow() };
    if (pending.kind === 'question') g.questions[pending.index].a = ans;
    else if (pending.kind === 'closing') g.closing.a = ans;
    else g.clarify.a = ans;
    day.guided = g;
    saveWeekData(w);
    ta.value = '';
    renderGuided();
    continueGuidedFlow();
  }
  function skipClosing(){
    const w = loadWeekData();
    const day = w[currentDay];
    const g = guidedFor(day);
    if (!g.closing || g.closing.a) return;
    stopDictation();
    g.closing.skipped = true;
    day.guided = g;
    saveWeekData(w);
    renderGuided();
    continueGuidedFlow();
  }
  function setGuidedLoading(text){
    const el = document.getElementById('guidedLoading');
    el.hidden = !text;
    if (text) document.getElementById('guidedLoadingText').textContent = text;
  }
  function showGuidedError(msg){
    const el = document.getElementById('guidedError');
    el.textContent = msg || '';
    el.hidden = !msg;
  }
  async function continueGuidedFlow(){
    if (guidedBusy) return;
    const dayKey = currentDay;
    let w = loadWeekData();
    let g = guidedFor(w[dayKey]);
    if (guidedPending(g) || g.summary) return;
    if (!g.questions.every(x => x.a)) return;
    guidedBusy = true;
    showGuidedError('');
    renderGuided();
    const qa = guidedQA(g);
    const narrative = (w[dayKey].aiSummary && w[dayKey].aiSummary.narrative) || '';
    try {
      if (!g.clarifyChecked){
        setGuidedLoading('Reading your answers…');
        const data = await callWorker({ mode: 'clarify', day: dayKey, qa, daySummary: narrative });
        if (typeof data.needsClarification !== 'boolean') throw workerOutdatedError();
        w = loadWeekData(); g = guidedFor(w[dayKey]);
        g.clarifyChecked = true;
        if (data.needsClarification && typeof data.question === 'string' && data.question.trim()){
          g.clarify = { q: data.question.trim(), a: null };
        }
        w[dayKey].guided = g;
        saveWeekData(w);
        if (g.clarify && !g.clarify.a){ return; } // wait for the teacher's answer
      }
      if (!g.closing){
        // v4.5: ask the last, skippable question before summing up
        g.closing = { q: CLOSING_QUESTION, a: null, skipped: false };
        w[dayKey].guided = g;
        saveWeekData(w);
        return;
      }
      setGuidedLoading('Summing up your reflection…');
      const clar = (g.clarify && g.clarify.a) ? { q: g.clarify.q, a: g.clarify.a.text } : null;
      const data2 = await callWorker({ mode: 'reflectionSummary', day: dayKey, qa, clarify: clar, daySummary: narrative });
      if (typeof data2.summary !== 'string' || !data2.summary.trim()) throw workerOutdatedError();
      w = loadWeekData(); g = guidedFor(w[dayKey]);
      g.summary = { text: data2.summary.trim(), generatedAt: stampNow(), rating: null };
      w[dayKey].guided = g;
      saveWeekData(w);
    } catch (e){
      showGuidedError((e && e.message) || 'Could not reach the analysis service. Please try again.');
    } finally {
      guidedBusy = false;
      setGuidedLoading('');
      if (currentDay === dayKey) renderGuided();
    }
  }
  function workerOutdatedError(){
    return new Error('The analysis service answered in an unexpected format. If you just updated TeacherBuddy, the analysis service probably needs the new teacherbuddy-worker.js code too.');
  }
  function rateReflectionSummary(rating){
    const w = loadWeekData();
    const day = w[currentDay];
    const g = guidedFor(day);
    if (!g.summary) return;
    g.summary.rating = rating;
    g.summary.ratedAt = stampNow();
    g.summary.correctionDeclined = false;
    correctionOpen = false;
    day.guided = g;
    day.reflectionSubmitted = true;
    saveWeekData(w);
    renderGuided();
  }
  // v4.0.2: after a "partly" / "missed it" rating, offer the teacher the
  // chance to say what was missed. Her correction goes back to Claude for a
  // revised summary, which she rates again. Declining leaves it flagged for
  // the coach. Each earlier version is kept in g.revisions for the record.
  let correctionOpen = false;
  function openCorrection(){ correctionOpen = true; renderGuided(); setTimeout(() => { const t = document.getElementById('correctionAnswer'); if (t) t.focus(); }, 50); }
  function closeCorrection(){ stopDictation(); correctionOpen = false; renderGuided(); }
  function declineCorrection(){
    const w = loadWeekData(); const day = w[currentDay]; const g = guidedFor(day);
    if (!g.summary) return;
    g.summary.correctionDeclined = true;
    day.guided = g; saveWeekData(w); renderGuided();
  }
  async function sendCorrection(){
    const ta = document.getElementById('correctionAnswer');
    const text = ta.value.trim();
    if (!text || guidedBusy) return;
    stopDictation();
    dictationUsed.correctionAnswer = false;
    const dayKey = currentDay;
    let w = loadWeekData();
    let g = guidedFor(w[dayKey]);
    if (!g.summary) return;
    guidedBusy = true;
    correctionOpen = false;
    showGuidedError('');
    renderGuided();
    setGuidedLoading('Revising the summary with what you added…');
    try {
      const qa = guidedQA(g);
      const clar = (g.clarify && g.clarify.a) ? { q: g.clarify.q, a: g.clarify.a.text } : null;
      const narrative = (w[dayKey].aiSummary && w[dayKey].aiSummary.narrative) || '';
      const data = await callWorker({ mode: 'reflectionSummary', day: dayKey, qa, clarify: clar, daySummary: narrative,
        correction: { previousSummary: g.summary.text, text } });
      if (typeof data.summary !== 'string' || !data.summary.trim()) throw workerOutdatedError();
      w = loadWeekData(); g = guidedFor(w[dayKey]);
      g.revisions = (g.revisions || []).concat([{ text: g.summary.text, rating: g.summary.rating }]);
      g.summary = { text: data.summary.trim(), generatedAt: stampNow(), rating: null, revisedAfterClarifying: true };
      w[dayKey].guided = g;
      w[dayKey].reflectionSubmitted = false; // needs rating again
      saveWeekData(w);
      ta.value = '';
    } catch (e){
      correctionOpen = true;
      showGuidedError((e && e.message) || 'Could not reach the analysis service. Please try again.');
    } finally {
      guidedBusy = false;
      setGuidedLoading('');
      if (currentDay === dayKey) renderGuided();
    }
  }
  // ---------- v4.2: teaching sessions (from Read my day), one rating ----------
  // Rating comes before any clarifying, so firstRating records how accurate
  // the AI was on its own. "Partly"/"missed it" offers a clarification that
  // revises the sessions; declining flags it for the coach.
  let teachCorrectionOpen = false, teachBusy = false;
  function renderTeaching(){
    const w = loadWeekData();
    const day = w[currentDay];
    const tl = day.timeline;
    const sessions = (tl && Array.isArray(tl.teachingSessions)) ? tl.teachingSessions : [];
    const body = document.getElementById('teachingSessionsBody');
    if (!body) return;
    body.innerHTML = '';
    if (!tl){
      body.innerHTML = '<div class="empty-state">Use <strong>Read my day</strong> in step 1 and your teaching sessions will be summed up here.</div>';
    } else if (!sessions.length){
      body.innerHTML = '<div class="empty-state">No teaching sessions were found in today\'s transcript.</div>';
    }
    sessions.forEach((ts, i) => {
      const el = document.createElement('div');
      el.className = 'session';
      el.innerHTML = '<div class="session-head">Session ' + (i + 1) + ', ' + escapeHtml(ts.start) + '–' + escapeHtml(ts.end) + '</div>' +
        (ts.quote ? '<div class="quote">"' + escapeHtml(ts.quote) + '"</div>' : '') +
        '<div class="session-sum">' + escapeHtml(ts.summary) + '</div>';
      body.appendChild(el);
    });
    const review = (tl && tl.teachingReview) || {};
    const show = sessions.length > 0 && !teachBusy;
    document.getElementById('teachingReview').hidden = !show;
    if (!show) return;
    document.querySelectorAll('#teachRatingRow .chip-btn').forEach(btn => btn.classList.toggle('primary', btn.dataset.rating === review.rating));
    const flagged = review.rating === 'partly' || review.rating === 'missed';
    document.getElementById('teachClarifyWrap').hidden = !flagged;
    document.getElementById('teachClarifyOffer').hidden = !(flagged && !review.correctionDeclined && !teachCorrectionOpen);
    document.getElementById('teachCorrectionComposer').hidden = !(flagged && teachCorrectionOpen);
    document.getElementById('teachCoachFlag').hidden = !(flagged && review.correctionDeclined);
    const noteShown = document.getElementById('teachNoteShown');
    noteShown.hidden = !review.note;
    noteShown.textContent = review.note ? 'Your note: ' + review.note : '';
    document.getElementById('teachNoteLink').textContent = review.note ? 'Edit note' : '+ Add a note';
  }
  function updateTeachReview(patch){
    const w = loadWeekData();
    const tl = w[currentDay].timeline;
    if (!tl) return null;
    tl.teachingReview = Object.assign({ rating: null, firstRating: null, note: '', correctionDeclined: false, revisedAfterClarifying: false, revisions: [] }, tl.teachingReview || {}, patch);
    saveWeekData(w);
    return tl.teachingReview;
  }
  function rateTeaching(r){
    const cur = (loadWeekData()[currentDay].timeline || {}).teachingReview || {};
    updateTeachReview({ rating: r, ratedAt: stampNow(), firstRating: cur.firstRating || r, correctionDeclined: false });
    teachCorrectionOpen = false;
    renderTeaching();
  }
  function openTeachCorrection(){ teachCorrectionOpen = true; renderTeaching(); setTimeout(() => { const t = document.getElementById('teachCorrectionAnswer'); if (t) t.focus(); }, 50); }
  function closeTeachCorrection(){ stopDictation(); teachCorrectionOpen = false; renderTeaching(); }
  function declineTeachCorrection(){ updateTeachReview({ correctionDeclined: true }); renderTeaching(); }
  function openTeachNote(){
    const box = document.getElementById('teachNoteBox');
    box.hidden = false;
    const review = (loadWeekData()[currentDay].timeline || {}).teachingReview || {};
    document.getElementById('teachNoteText').value = review.note || '';
    document.getElementById('teachNoteText').focus();
  }
  function saveTeachNote(){
    updateTeachReview({ note: document.getElementById('teachNoteText').value.trim() });
    document.getElementById('teachNoteBox').hidden = true;
    renderTeaching();
  }
  async function sendTeachCorrection(){
    const ta = document.getElementById('teachCorrectionAnswer');
    const text = ta.value.trim();
    if (!text || teachBusy) return;
    stopDictation();
    const dayKey = currentDay;
    const w = loadWeekData();
    const tl = w[dayKey].timeline;
    if (!tl) return;
    teachBusy = true; teachCorrectionOpen = false;
    document.getElementById('teachingError').hidden = true;
    document.getElementById('teachingLoading').hidden = false;
    renderTeaching();
    try {
      const data = await callWorker({ mode: 'teachingRevise', day: dayKey,
        sessions: tl.teachingSessions.map(x => ({ start: x.start, end: x.end, summary: x.summary })),
        correction: text, transcript: (w[dayKey].transcript || []).map(l => ({ at: l.at, text: l.text })) });
      if (!Array.isArray(data.teachingSessions)) throw workerOutdatedError();
      const w2 = loadWeekData();
      const tl2 = w2[dayKey].timeline;
      const old = tl2.teachingSessions;
      const rev = tl2.teachingReview || {};
      tl2.teachingSessions = data.teachingSessions.map(x => {
        const match = old.find(o => o.start === x.start);
        return { start: String(x.start || ''), end: String(x.end || ''), summary: String(x.summary || ''), quote: match ? match.quote : '' };
      });
      tl2.teachingReview = Object.assign({}, rev, {
        revisions: (rev.revisions || []).concat([{ sessions: old.map(o => ({ start: o.start, end: o.end, summary: o.summary })), rating: rev.rating, clarification: text }]),
        rating: null, revisedAfterClarifying: true, correctionDeclined: false
      });
      saveWeekData(w2);
      ta.value = '';
    } catch (e){
      teachCorrectionOpen = true;
      const el = document.getElementById('teachingError');
      el.textContent = (e && e.message) || 'Could not reach the analysis service. Please try again.';
      el.hidden = false;
    } finally {
      teachBusy = false;
      document.getElementById('teachingLoading').hidden = true;
      if (currentDay === dayKey) renderTeaching();
    }
  }

  // ---------- v4.2: daily stress check (after Thompson et al.'s daily survey) ----------
  function setStress(v){
    const w = loadWeekData();
    w[currentDay].stress = { value: v, at: stampNow() };
    saveWeekData(w);
    renderStress();
  }
  function renderStress(){
    const st = loadWeekData()[currentDay].stress;
    document.querySelectorAll('#stressRow .chip-btn').forEach(b => b.classList.toggle('primary', !!st && String(st.value) === b.dataset.v));
  }

  // Kept so any older call site is harmless; the AI summary is no longer locked.
  function updateAiSummaryGate(){}

  // ---------- Speak instead of type (browser speech recognition) ----------
  // Turns speech into text inside a textarea the teacher can fix before
  // sending. No audio is recorded or kept for these answers.
  let dictation = null;
  const dictationUsed = {};
  function setMicNote(noteId, text){
    const el = noteId && document.getElementById(noteId);
    if (!el) return;
    el.textContent = text || '';
    el.hidden = !text;
  }
  function stopDictation(){
    if (!dictation) return;
    const d = dictation;
    dictation = null;
    try { d.recog.onend = null; d.recog.stop(); } catch (e){ /* already stopped */ }
    const btn = document.getElementById(d.btnId);
    if (btn){ btn.textContent = '🎙 Speak'; btn.classList.remove('recording'); }
    setMicNote(d.noteId, '');
  }
  function toggleDictation(textareaId, btnId, noteId){
    if (dictation && dictation.textareaId === textareaId){ stopDictation(); return; }
    stopDictation();
    if (bigRecording){ setMicNote(noteId, 'Stop the recording on Live the Day first. The browser can only listen for one thing at a time.'); return; }
    const SR = window.SpeechRecognition || window.webkitSpeechRecognition;
    if (!SR){ setMicNote(noteId, 'Speaking needs Google Chrome. You can type your answer instead.'); return; }
    const ta = document.getElementById(textareaId);
    const recog = new SR();
    recog.continuous = true;
    recog.interimResults = true;
    recog.lang = 'en-US';
    let base = ta.value ? ta.value.replace(/\s*$/, ' ') : '';
    recog.onresult = (event) => {
      let interim = '';
      for (let i = event.resultIndex; i < event.results.length; i++){
        const res = event.results[i];
        const t = res[0].transcript.trim();
        if (res.isFinal){ if (t) base += t + ' '; }
        else interim += t + ' ';
      }
      ta.value = base + interim;
      dictationUsed[textareaId] = true;
    };
    recog.onerror = (event) => {
      if (event.error === 'not-allowed' || event.error === 'service-not-allowed'){
        stopDictation();
        setMicNote(noteId, 'Microphone access was blocked. Allow it in your browser\'s site settings, or type instead.');
      }
    };
    recog.onend = () => {
      // Chrome stops after a pause; keep listening until the teacher taps Stop.
      if (dictation && dictation.recog === recog){ try { recog.start(); } catch (e){ stopDictation(); } }
    };
    dictation = { recog, textareaId, btnId, noteId };
    try { recog.start(); } catch (e){ dictation = null; setMicNote(noteId, 'Couldn\'t start listening. Try again in a moment.'); return; }
    const btn = document.getElementById(btnId);
    if (btn){ btn.textContent = '■ Stop'; btn.classList.add('recording'); }
    setMicNote(noteId, 'Listening… tap Stop when you\'re done, then check the text before sending.');
  }

  // Every timestamp shown in the app goes through here.
  // (older note) regardless of the device's own
  // clock/timezone setting — so a recording looks the same whether it's
  // viewed on a US-timezone laptop or an other-timezone one.
  // v4.0: follow the device's own time zone (previously fixed to local time).
  const DISPLAY_TIMEZONE = (function(){
    try { return Intl.DateTimeFormat().resolvedOptions().timeZone || 'Asia/Jakarta'; } catch (e){ return 'Asia/Jakarta'; }
  })();
  function tzLabel(){
    try {
      const part = new Intl.DateTimeFormat('en-US', { timeZone: DISPLAY_TIMEZONE, timeZoneName: 'short' })
        .formatToParts(new Date()).find(x => x.type === 'timeZoneName');
      return part ? part.value : DISPLAY_TIMEZONE;
    } catch (e){ return DISPLAY_TIMEZONE; }
  }
  function stampNow(){
    try {
      return new Date().toLocaleTimeString('en-US', { timeZone: DISPLAY_TIMEZONE, hour: 'numeric', minute: '2-digit', hour12: true });
    } catch (e){
      // Fallback for a browser that somehow doesn't recognize the timezone name —
      // extremely unlikely, but better than a crash.
      const now = new Date();
      const h = now.getHours() % 12 || 12;
      const m = String(now.getMinutes()).padStart(2,'0');
      return h + ':' + m + ' ' + (now.getHours() >= 12 ? 'PM' : 'AM');
    }
  }

  // ---------- AI-powered day summary (paid backend) ----------
  // As of v3.15, this fires automatically from submitReflection() for any day
  // with a transcript — not a separate opt-in click anymore (disclosed as
  // such in Privacy & Consent). It never runs on a timer or on every
  // utterance — only once, right after the teacher submits that day's
  // reflection. It sends that day's saved transcript (see logTranscriptLine)
  // together with the teacher's own reflections and incident explanations,
  // so Claude reads the classroom and the teacher's own sense of it
  // together, as one combined picture. This file is public static HTML, so
  // AI_SHARED_TOKEN below is just a basic abuse gate, not a real secret —
  // the real secret (the Anthropic API key) lives only in the Worker's own
  // server settings and never appears in this file.
  const AI_WORKER_URL = '';
  const AI_SHARED_TOKEN = '';

  function getDeviceId(){
    let id = null;
    try { id = localStorage.getItem('tbanon_device_id'); } catch (e){ /* best effort only */ }
    if (!id){
      id = 'device-' + Date.now() + '-' + Math.random().toString(36).slice(2, 10);
      try { localStorage.setItem('tbanon_device_id', id); } catch (e){ /* best effort only */ }
    }
    return id;
  }

  function escapeHtmlLite(s){
    const div = document.createElement('div');
    div.textContent = s == null ? '' : String(s);
    return div.innerHTML;
  }

  const RESPONSIVE_SHORT = { substance: 'substance of ideas', disciplinary: 'disciplinary connections', pursuing: 'pursuing thinking' };
  const RESPONSIVE_LABELS = {
    substance: 'Foregrounding the substance of students\' ideas',
    disciplinary: 'Recognizing disciplinary connections in students\' ideas',
    pursuing: 'Taking up and pursuing students\' thinking'
  };
  // Lists from the day summary. listKey items can be removed by the teacher
  // (kept by default); removed ones stay saved but never show or print.
  function renderAiSummaryList(container, title, items, listKey, opts){
    opts = opts || {};
    const kept = (items || []).map((it, i) => ({ it, i })).filter(x => !x.it.removed);
    if (!kept.length) return;
    const h = document.createElement('div');
    h.className = 'ai-summary-list-title';
    h.textContent = title;
    container.appendChild(h);
    if (opts.hint){
      const hint = document.createElement('div');
      hint.className = 'tm-note'; hint.style.margin = '-2px 0 4px';
      hint.textContent = opts.hint;
      container.appendChild(hint);
    }
    kept.forEach(({ it, i }) => {
      const row = document.createElement('div');
      row.className = 'ach-item';
      const dot = document.createElement('span');
      dot.className = 'dot' + (opts.dotClass ? ' ' + opts.dotClass : '');
      row.appendChild(dot);
      const txt = document.createElement('span');
      txt.style.flex = '1';
      let headline = it.label || (opts.labelFor ? opts.labelFor(it) : '');
      txt.innerHTML = (headline ? '<strong>' + escapeHtmlLite(headline) + ':</strong> ' : '') + escapeHtmlLite(it.detail || '')
        + (it.at ? ' <span style="color:var(--text-muted); font-size:12px;">· ' + escapeHtmlLite(it.at) + '</span>' : '')
        + (it.linkedToGoal ? ' <span class="goal-badge">★ Your goal</span>' : '')
        + (opts.showThompson && incidentThompsonLabel(it) ? '<div class="tm-note" style="margin-top:2px;">' + escapeHtmlLite(incidentThompsonLabel(it)) + '</div>' : '')
        + (it.quote ? '<div class="quote">"' + escapeHtmlLite(it.quote) + '"</div>' : '');
      row.appendChild(txt);
      if (listKey){
        const rm = document.createElement('button');
        rm.className = 'remove-btn'; rm.title = 'This isn\'t right, remove it'; rm.textContent = '✕';
        rm.onclick = () => removeSummaryItem(listKey, i);
        row.appendChild(rm);
      }
      container.appendChild(row);
    });
  }
  function removeSummaryItem(listKey, i){
    const w = loadWeekData();
    const sm = w[currentDay].aiSummary;
    if (!sm || !Array.isArray(sm[listKey]) || !sm[listKey][i]) return;
    sm[listKey][i].removed = true;
    saveWeekData(w);
    renderAiSummary(currentDay);
  }

  // Renders the "growth lens" read of the day (Desimone's five features of
  // effective PD, via Sherman & Teemant's hybridity framing) — only the
  // features Claude marked as genuinely evident are shown, plus the
  // connecting hybridity note if there is one. The whole block stays hidden
  // if nothing was evident, rather than showing five empty/negative rows.
  function renderGrowthLens(lens){
    const wrap = document.getElementById('aiSummaryGrowthLens');
    const itemsEl = document.getElementById('aiSummaryLensItems');
    const noteEl = document.getElementById('aiSummaryLensHybridity');
    if (!wrap) return;
    const features = (lens && Array.isArray(lens.features)) ? lens.features.filter(f => f && f.evident) : [];
    const note = (lens && lens.hybridityNote) || '';
    if (!features.length && !note){
      wrap.hidden = true;
      return;
    }
    wrap.hidden = false;
    itemsEl.innerHTML = '';
    features.forEach(f => {
      const row = document.createElement('div');
      row.className = 'ach-item';
      const dot = document.createElement('span');
      dot.className = 'dot lens';
      row.appendChild(dot);
      const txt = document.createElement('span');
      txt.innerHTML = '<strong>' + escapeHtmlLite(f.feature || '') + ':</strong> ' + escapeHtmlLite(f.detail || '');
      row.appendChild(txt);
      itemsEl.appendChild(row);
    });
    noteEl.textContent = note;
    noteEl.hidden = !note;
  }

  // Renders whatever is already saved for this day (or the idle "get a
  // summary" prompt if nothing's been generated yet) — called whenever the
  // Reflection tab for a given day is shown, so a summary generated earlier
  // this week is still there if the teacher comes back to it.
  function renderAiSummary(day){
    const idleEl = document.getElementById('aiSummaryIdle');
    const loadingEl = document.getElementById('aiSummaryLoading');
    const errEl = document.getElementById('aiSummaryError');
    const errDetailEl = document.getElementById('aiSummaryErrorDetail');
    const resultEl = document.getElementById('aiSummaryResult');
    if (!idleEl) return; // page not built yet
    loadingEl.hidden = true;
    errEl.hidden = true;
    if (errDetailEl) errDetailEl.hidden = true;

    const w = loadWeekData();
    const summary = w[day] && w[day].aiSummary;
    if (!summary){
      idleEl.hidden = false;
      resultEl.hidden = true;
      return;
    }
    idleEl.hidden = true;
    resultEl.hidden = false;
    document.getElementById('aiSummaryNarrative').textContent = summary.narrative || '';
    const listsEl = document.getElementById('aiSummaryLists');
    listsEl.innerHTML = '';
    const onboardingGoal = getOnboarding().goal;
    renderAiSummaryList(listsEl, 'Your achievements', summary.achievements, 'achievements',
      { hint: 'Remove any that don\'t feel true.' + (onboardingGoal ? ' ★ marks progress on your goal: "' + onboardingGoal + '."' : '') });
    renderAiSummaryList(listsEl, 'Responsive teaching moments', summary.responsiveMoments, 'responsiveMoments',
      { dotClass: 'lens', labelFor: m => RESPONSIVE_LABELS[m.feature] || m.feature, hint: 'After Robertson, Scherr & Hammer (2016). Remove any that don\'t fit.' });
    renderAiSummaryList(listsEl, 'Anecdotes', summary.anecdotes);
    renderAiSummaryList(listsEl, 'Needs a follow-up', summary.incidents, null, { showThompson: true });
    if (!(summary.achievements || []).length && !(summary.responsiveMoments || []).length && !(summary.anecdotes || []).length && !(summary.incidents || []).length){
      const none = document.createElement('div');
      none.className = 'empty-state';
      none.textContent = 'No specific achievements, anecdotes, or incidents stood out beyond the narrative above.';
      listsEl.appendChild(none);
    }
    renderGrowthLens(summary.growthLens);
    const stampEl = document.getElementById('aiSummaryStamp');
    if (stampEl) stampEl.textContent = summary.generatedAt ? ('Generated at ' + summary.generatedAt) : '';
  }

  // One place that talks to the Worker, for every mode.
  async function callWorker(payload){
    throw new Error('AI features are switched off in this anonymous demo. The sample week already includes its results.');
    const resp = await fetch(AI_WORKER_URL, {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'X-TeacherBuddy-Token': AI_SHARED_TOKEN,
        'X-Device-Id': getDeviceId(),
      },
      body: JSON.stringify(payload),
    });
    const data = await resp.json().catch(() => null);
    if (!resp.ok){
      const err = new Error((data && data.error) || ('The analysis service returned an error (HTTP ' + resp.status + ').'));
      err.detail = (data && typeof data.detail === 'string') ? data.detail : '';
      throw err;
    }
    return data || {};
  }
  function timeTagsFor(day){
    return quietBlocksFor(day).map(b => ({
      at: b.endAt || '?',
      minutes: Number(b.minutes) || 0,
      category: b.tag ? catLabel(b.tag.cat) : 'Not tagged',
      activity: (b.tag && b.tag.activity) || ''
    }));
  }

  async function requestAiSummary(){
    const idleEl = document.getElementById('aiSummaryIdle');
    const loadingEl = document.getElementById('aiSummaryLoading');
    const errEl = document.getElementById('aiSummaryError');
    const errDetailEl = document.getElementById('aiSummaryErrorDetail');
    const resultEl = document.getElementById('aiSummaryResult');
    const btn = document.getElementById('aiSummaryBtn');
    const dayKey = currentDay;

    const w = loadWeekData();
    const day = w[dayKey];
    const hasTranscript = day.transcript && day.transcript.length;
    const hasTags = quietBlocksFor(day).some(b => b.tag);
    if (!hasTranscript && !hasTags){
      errEl.textContent = 'There\'s nothing recorded or tagged for this day yet. Record part of the day on Live the Day first. You can still answer the reflection questions below without a summary.';
      errEl.hidden = false;
      if (errDetailEl) errDetailEl.hidden = true;
      return;
    }

    idleEl.hidden = true;
    resultEl.hidden = true;
    errEl.hidden = true;
    if (errDetailEl) errDetailEl.hidden = true;
    loadingEl.hidden = false;
    if (btn) btn.disabled = true;

    try {
      const t = computeDayTime(day);
      const data = await callWorker({
        mode: 'day',
        day: dayKey,
        transcript: day.transcript,
        replies: day.replies,
        incidents: day.incidents,
        recordingSessions: day.recordingSessions,
        timeTags: timeTagsFor(day),
        timeMap: { faceToFace: Math.round(t.face), prepAdmin: Math.round(t.prep), wellbeing: Math.round(t.wellbeing), outsideClassroom: Math.round(t.outside), breaks: Math.round(t.break), untagged: Math.round(t.untagged) },
        timeZone: tzLabel(),
        goal: getOnboarding().goal || '',
        subject: getProfile().subject || '',
      });
      const w2 = loadWeekData();
      w2[dayKey].aiSummary = {
        narrative: data.narrative || '',
        achievements: Array.isArray(data.achievements) ? data.achievements : [],
        responsiveMoments: Array.isArray(data.responsiveMoments) ? data.responsiveMoments.filter(m => m && RESPONSIVE_LABELS[m.feature]) : [],
        anecdotes: Array.isArray(data.anecdotes) ? data.anecdotes : [],
        incidents: Array.isArray(data.incidents) ? data.incidents : [],
        growthLens: (data.growthLens && typeof data.growthLens === 'object') ? data.growthLens : null,
        reflectionQuestions: Array.isArray(data.reflectionQuestions) ? data.reflectionQuestions.filter(q => typeof q === 'string').slice(0, 3) : [],
        generatedAt: stampNow(),
      };
      // Fresh questions replace the standard ones only if the teacher hasn't
      // started answering yet. Answers already given are never thrown away.
      const g = w2[dayKey].guided;
      if (g && Array.isArray(g.questions) && !g.questions.some(x => x.a)) w2[dayKey].guided = null;
      saveWeekData(w2);
      loadingEl.hidden = true;
      if (currentDay === dayKey){ renderAiSummary(dayKey); renderGuided(); }
    } catch (e){
      loadingEl.hidden = true;
      idleEl.hidden = false;
      errEl.textContent = (e && e.message) || 'Could not reach the analysis service. Please try again in a moment.';
      errEl.hidden = false;
      if (errDetailEl){
        const detail = (e && e.detail) || '';
        errDetailEl.textContent = detail ? ('Technical detail: ' + detail.slice(0, 300)) : '';
        errDetailEl.hidden = !detail;
      }
    } finally {
      if (btn) btn.disabled = false;
    }
  }

  function clearCheckinEmptyState(){
    const el = document.getElementById('checkinEmptyState');
    if (el) el.remove();
  }
  // Always opens the reply box rather than toggling it closed again — since
  // "Explain this" (setActiveFollowUp) now also opens this same box
  // automatically, a blind toggle here would let a teacher who clicks this
  // button out of habit accidentally close a box that's already open and
  // ready to type in.
  function toggleTyping(){ document.getElementById('typingDialog').classList.add('show'); }
  function sendTypedReply(){
    const textarea = document.querySelector('#typingDialog textarea');
    const text = textarea.value.trim();
    if (!text) return;
    clearCheckinEmptyState();
    document.getElementById('checkinChat').appendChild(buildMeBubble(text, stampNow()));
    logReply(currentDay, text);
    if (activeFollowUpId){
      resolveFollowUp(activeFollowUpId, text, 'typed', activeFollowUpSupport);
      clearActiveFollowUp();
    }
    textarea.value = '';
    document.getElementById('typingDialog').classList.remove('show');
  }

  // ---------- Diagnostics panel ----------
  // Teacher-facing troubleshooting info, read aloud or screenshotted when
  // something's wrong — nothing on this panel is ever sent anywhere.
  function openDiagnostics(){
    const body = document.getElementById('diagnosticsBody');
    if (!body) return;
    const w = loadWeekData();
    const p = getProfile();
    body.innerHTML = '';

    function addRow(label, value, id){
      const row = document.createElement('div');
      const l = document.createElement('div');
      l.className = 'field-label';
      l.style.marginBottom = '2px';
      l.textContent = label;
      const v = document.createElement('div');
      v.style.cssText = 'font-size:12.5px; color:var(--text); word-break:break-word;';
      if (id) v.id = id;
      v.textContent = value;
      row.appendChild(l); row.appendChild(v);
      body.appendChild(row);
    }

    addRow('Teacher', p.name || '(not set)');
    addRow('App version', 'Anonymous demo · sample week');
    addRow('Microphone permission', 'checking…', 'diagMicState');
    addRow('Live speech-to-text supported', recognitionSupported ? 'Yes — this browser has the Web Speech API' : 'No — audio-only recording still works, but there\'s no live transcript or auto-flagging in this browser');
    addRow('Recognition language', RECOG_LANG + ' (English only) · lines under ' + MIN_CONFIDENCE + ' confidence, or that look other-language, are hidden');
    const hid = (w[currentDay] && w[currentDay].hiddenLines) || [];
    addRow('Hidden lines today', hid.length ? hid.length + ' — ' + hid.slice(-8).map(h => '[' + h.reason + (typeof h.conf === 'number' ? ' ' + h.conf.toFixed(2) : '') + '] ' + h.text).join('  |  ') : 'None');
    addRow('Days recorded this week', DAYS.map(d => DAY_LABELS_FULL[d] + ': ' + (w[d].recorded ? 'recorded' : 'not yet')).join('  ·  '));
    const todaySessions = (w[currentDay] && w[currentDay].recordingSessions) || [];
    addRow('Today\'s recording session(s)', todaySessions.length
      ? todaySessions.map(s => s.start + '–' + s.stop).join(', ') + ' (' + tzLabel() + ')'
      : 'None yet today');

    let storageBytes = 0;
    try {
      ['tbanon_profile','tbanon_onboarding','tbanon_week','tbanon_device_id','tbanon_setup_complete'].forEach(k => {
        const v = localStorage.getItem(k);
        if (v) storageBytes += v.length;
      });
    } catch (e){ /* best effort only */ }
    addRow('Local storage used by TeacherBuddy', (storageBytes / 1024).toFixed(1) + ' KB');
    addRow('Device ID (used for the AI-summary daily cap)', getDeviceId());
    addRow('Recent errors this session', _recentErrors.length ? _recentErrors.map(e => e.at + ' — ' + e.msg).join('  |  ') : 'None recorded');

    document.getElementById('diagnosticsModal').hidden = false;

    if (navigator.permissions && navigator.permissions.query){
      navigator.permissions.query({ name: 'microphone' }).then(status => {
        const el = document.getElementById('diagMicState');
        if (el) el.textContent = status.state;
      }).catch(() => {
        const el = document.getElementById('diagMicState');
        if (el) el.textContent = 'unknown — this browser can\'t report it';
      });
    } else {
      const el = document.getElementById('diagMicState');
      if (el) el.textContent = 'unknown — this browser can\'t report it';
    }
  }
</script>

