  // ---------- v4.5: estimate vs actual, with a question for each gap over 25% ----------
  const GAP_THRESHOLD = 0.25;
  function computeGaps(wt){
    const out = [];
    if (!wt.hasEstimates) return out;
    WORK_CATS.forEach(k => {
      const r = wt.rows[k];
      const est = r.estimate || 0, actual = r.school + r.after, diff = actual - est;
      let flagged, pct = null;
      if (est > 0){ pct = diff / est; flagged = Math.abs(pct) > GAP_THRESHOLD; }
      else { flagged = actual >= 1; }
      out.push({ cat: k, est, actual, diff, pct, flagged });
    });
    return out;
  }
  function gapQuestion(g){
    const label = catLabel(g.cat).toLowerCase();
    const acts = (TIME_CATEGORIES[g.cat].activities || []).slice(0, 3).join(', ').toLowerCase();
    let lead;
    if (g.est > 0){
      lead = 'You estimated about ' + fmtHrs(g.est) + ' hours on ' + label + ' this week, and the week shows about ' + fmtHrs(g.actual) + ' (' + Math.round(Math.abs(g.pct) * 100) + '% ' + (g.diff > 0 ? 'more' : 'less') + ').';
    } else {
      lead = 'You didn\'t estimate any time on ' + label + ', but the week shows about ' + fmtHrs(g.actual) + ' hours.';
    }
    return lead + ' What do you make of that gap? (Thompson et al. (2024) count things like ' + acts + ' here.)';
  }
  function gapTableHtml(gaps, forPrint){
    let html = '<table' + (forPrint ? '' : ' class="wt-table"') + '><thead><tr><th>Category</th><th>Estimate</th><th>Actual</th><th>Difference</th></tr></thead><tbody>';
    gaps.forEach(g => {
      const diffTxt = (g.diff >= 0 ? '+' : '−') + fmtHrs(Math.abs(g.diff)) + (g.pct !== null ? ' (' + (g.diff >= 0 ? '+' : '−') + Math.round(Math.abs(g.pct) * 100) + '%)' : '') + (g.flagged ? ' ⚑' : '');
      html += '<tr><td>' + escapeHtml(catLabel(g.cat)) + '</td><td>' + fmtHrs(g.est) + '</td><td>' + fmtHrs(g.actual) + '</td><td>' + diffTxt + '</td></tr>';
    });
    return html + '</tbody></table>';
  }
  function renderGapReflections(){
    const body = document.getElementById('gapBody');
    if (!body) return;
    const w = loadWeekData();
    const gaps = computeGaps(computeWeekTime(w));
    const saved = (w.gapReflections && typeof w.gapReflections === 'object') ? w.gapReflections : {};
    const card = document.getElementById('gapCard');
    if (!gaps.length){
      body.innerHTML = '<div class="empty-state">Add your weekly hour estimates (setup, or the link under the time table) and TeacherBuddy can compare them with what the week shows.</div>';
      return;
    }
    const recorded = DAYS.filter(d => w[d].recorded).length;
    body.innerHTML = gapTableHtml(gaps, false) +
      (recorded < 5 ? '<p class="wt-note">Only ' + recorded + ' of 5 days were recorded, so "actual" is partial and gaps may look bigger than they are.</p>' : '') +
      '<p class="wt-note">⚑ = more than 25% away from your estimate (or 1+ hour in a category you estimated at 0).</p>';
    const flagged = gaps.filter(g => g.flagged);
    if (!flagged.length){
      body.appendChild(Object.assign(document.createElement('div'), { className: 'empty-state', textContent: 'Every category is within 25% of your estimate, so there is nothing to ask about.' }));
      return;
    }
    flagged.forEach(g => {
      const key = g.cat;
      const ans = saved[key];
      const wrap = document.createElement('div');
      wrap.style.cssText = 'margin-top:14px;';
      const q = gapQuestion(g);
      wrap.appendChild(botBubble(q, 'TeacherBuddy · ' + catLabel(g.cat)));
      if (ans && (ans.a || ans.skipped)){
        wrap.appendChild(ans.a ? buildMeBubble(ans.a, (ans.source === 'voice' ? 'Spoken' : 'Typed') + ' · ' + ans.at) : buildMeBubble('Skipped.', 'Skipped'));
