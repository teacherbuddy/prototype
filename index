  }

  const INTERRUPTION_LABELS = {
    greeting: 'a greeting',
    cough_or_sneeze: 'a cough or sneeze',
    music: 'music',
    brief_exchange: 'a quick exchange',
    sound: 'a sound the browser didn\'t turn into words',
    real_activity: 'real activity',
    unclear: 'unclear'
  };
  const SEGMENT_CATS = ['face', 'prep', 'wellbeing', 'outside', 'break'];

  async function requestTimeline(){
    const dayKey = currentDay;
    const w = loadWeekData();
    const day = w[dayKey];
    const err = document.getElementById('readDayError');
    err.hidden = true;
    if (!(day.transcript && day.transcript.length) && !(day.quietGaps && day.quietGaps.length)){
      err.textContent = 'There\'s no transcript for this day yet, so there\'s nothing to read. You can still tag the quiet stretches yourself.';
      err.hidden = false;
      return;
    }
    const cands = interruptionCandidates(day);
    document.getElementById('readDayIdle').hidden = true;
    document.getElementById('readDayLoading').hidden = false;
    try {
      const data = await callWorker({
        mode: 'timeline',
        day: dayKey,
        transcript: (day.transcript || []).map(l => ({ at: l.at, text: l.text })),
        quietGaps: sortedGaps(day).map(g => ({ start: g.startAt, end: g.endAt, minutes: g.minutes })),
        recordingSessions: day.recordingSessions,
        candidates: cands.map(c => ({ id: c.id, text: c.text, before: c.before, after: c.after, gapBeforeMin: c.gapBeforeMin, gapAfterMin: c.gapAfterMin, at: c.at })),
      });
      if (!Array.isArray(data.segments) || !Array.isArray(data.interruptions)) throw workerOutdatedError();
      const decisions = {};
      data.interruptions.forEach(d => { if (d && d.id) decisions[d.id] = d; });
      const merges = cands.map(c => {
        const d = decisions[c.id];
        const noWords = !c.text;
        const brief = noWords ? true : !!(d && d.brief);
        return { id: c.id, aStart: c.aStart, bStart: c.bStart, at: c.at, text: c.text,
          kind: noWords ? 'sound' : ((d && d.kind) || 'unclear'), reason: (d && typeof d.reason === 'string') ? d.reason.slice(0, 160) : '',
          accepted: brief, suggested: brief, teacherChanged: false };
      });
      const segments = data.segments.filter(sg => sg && SEGMENT_CATS.includes(sg.category)).slice(0, 40).map(sg => {
        const aiTag = { cat: sg.category, activity: sg.category === BREAK_CAT ? '' : String(sg.activity || '').slice(0, 60), source: 'ai' };
        return { start: String(sg.start || ''), end: String(sg.end || ''), kind: String(sg.kind || '').slice(0, 60), quote: String(sg.quote || '').slice(0, 300), aiTag, tag: aiTag, edited: false };
      });
      const teachingSessions = (Array.isArray(data.teachingSessions) ? data.teachingSessions : []).slice(0, 12).map(ts => ({
        start: String(ts.start || ''), end: String(ts.end || ''), summary: String(ts.summary || ''), quote: String(ts.quote || '')
      }));
      const w2 = loadWeekData();
      w2[dayKey].timeline = { segments, merges, teachingSessions, teachingReview: null, analyzedAt: stampNow() };
      saveWeekData(w2);
    } catch (e){
      err.textContent = (e && e.message) || 'Could not reach the analysis service. You can still tag the quiet stretches yourself.';
      err.hidden = false;
    } finally {
      document.getElementById('readDayLoading').hidden = true;
      if (currentDay === dayKey){ renderIdleList(); renderTimeTags(); renderTeaching(); }
      else document.getElementById('readDayIdle').hidden = false;
    }
  }
  function loadWeekData(){
    let w = null;
    try {
      const saved = localStorage.getItem('tbanon_week');
      if (saved) w = JSON.parse(saved);
    } catch (e){ /* best effort only */ }
    if (!w || typeof w !== 'object') w = {};
    DAYS.forEach(d => {
      // Merge onto a fresh emptyDay() so weeks saved by older versions (before
      // achievements/anecdotes/idleStretches/transcript/recordingSessions existed)
      // gain those fields instead of crashing the first time this build reads them.
      w[d] = Object.assign(emptyDay(), w[d] || {});
      if (!Array.isArray(w[d].achievements)) w[d].achievements = [];
      if (!Array.isArray(w[d].anecdotes)) w[d].anecdotes = [];
      if (!Array.isArray(w[d].idleStretches)) w[d].idleStretches = [];
      if (!Array.isArray(w[d].incidents)) w[d].incidents = [];
      if (!Array.isArray(w[d].transcript)) w[d].transcript = [];
      if (!Array.isArray(w[d].hiddenLines)) w[d].hiddenLines = [];
      if (!Array.isArray(w[d].recordingSessions)) w[d].recordingSessions = [];
      if (w[d].guided && typeof w[d].guided !== 'object') w[d].guided = null;
      if (!Array.isArray(w[d].quietGaps)) w[d].quietGaps = [];
      if (!w[d].blockTags || typeof w[d].blockTags !== 'object') w[d].blockTags = {};
      if (w[d].timeline && typeof w[d].timeline !== 'object') w[d].timeline = null;
      if (w[d].stress && typeof w[d].stress !== 'object') w[d].stress = null;
      if (typeof w[d].reflectionSubmitted !== 'boolean') w[d].reflectionSubmitted = false;
    });
    return w;
  }
  function saveWeekData(w){
    try { localStorage.setItem('tbanon_week', JSON.stringify(w)); } catch (e){ /* best effort only */ }
  }
  function logRecordedSeconds(day, seconds){
    if (!seconds) return;
