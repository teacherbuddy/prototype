  // ---------- Week time table: estimate vs at school vs after hours ----------
  function computeWeekTime(w){
    const onboarding = getOnboarding();
    const est = onboarding.estimates || null;
    const rows = {};
    WORK_CATS.concat([BREAK_CAT, 'untagged']).forEach(k => { rows[k] = { estimate: null, school: 0, after: 0 }; });
    if (est) WORK_CATS.forEach(k => { rows[k].estimate = Number(est[k]) || 0; });
    DAYS.forEach(d => {
      const t = computeDayTime(w[d]);
      WORK_CATS.concat([BREAK_CAT, 'untagged']).forEach(k => { rows[k].school += t[k] / 60; });
    });
    const ah = getAfterHours(w);
    ((ah && ah.entries) || []).forEach(e => { if (rows[e.cat]) rows[e.cat].after += (e.minutes || 0) / 60; });
    return { rows, hasEstimates: !!est, legacy: onboarding.allocations || {} };
  }
  function fmtHrs(h){ return (h === null || h === undefined) ? '—' : (Math.round(h * 10) / 10).toFixed(1); }
  function weekTimeTableHtml(wt, forPrint){
    const cls = forPrint ? '' : ' class="wt-table"';
    let html = '<table' + cls + '><thead><tr><th>Category</th><th>Your estimate</th><th>At school</th><th>After hours</th></tr></thead><tbody>';
    let tE = 0, tS = 0, tA = 0;
    WORK_CATS.forEach(k => {
      const r = wt.rows[k];
      tE += r.estimate || 0; tS += r.school; tA += r.after;
      html += '<tr><td>' + escapeHtml(catLabel(k)) + '</td><td>' + fmtHrs(r.estimate) + '</td><td>' + fmtHrs(r.school) + '</td><td>' + fmtHrs(r.after) + '</td></tr>';
    });
    html += '<tr class="wt-total"><td>Total work</td><td>' + (wt.hasEstimates ? fmtHrs(tE) : '—') + '</td><td>' + fmtHrs(tS) + '</td><td>' + fmtHrs(tA) + '</td></tr>';
    html += '<tr class="wt-aside"><td>Breaks (not counted as work)</td><td>—</td><td>' + fmtHrs(wt.rows[BREAK_CAT].school) + '</td><td>—</td></tr>';
    if (wt.rows.untagged.school > 0) html += '<tr class="wt-aside"><td>Quiet time not tagged yet</td><td>—</td><td>' + fmtHrs(wt.rows.untagged.school) + '</td><td>—</td></tr>';
