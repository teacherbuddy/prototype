  // ---------- Backup: export / import everything this app keeps ----------
  function exportAllData(){
    const data = {};
    try {
      for (let i = 0; i < localStorage.length; i++){
        const k = localStorage.key(i);
        if (k && k.indexOf('tbanon_') === 0) data[k] = localStorage.getItem(k);
      }
    } catch (e){ /* best effort only */ }
    const blob = new Blob([JSON.stringify({ app: 'TeacherBuddy', version: APP_VERSION, exportedAt: new Date().toISOString(), data }, null, 2)], { type: 'application/json' });
    const a = document.createElement('a');
    a.href = URL.createObjectURL(blob);
    a.download = 'teacherbuddy-backup-' + new Date().toISOString().slice(0, 10) + '.json';
    document.body.appendChild(a); a.click(); a.remove();
    const st = document.getElementById('backupStatus');
    if (st) st.textContent = 'Saved ' + Object.keys(data).length + ' items to your downloads.';
  }
  function importAllData(input){
    const file = input.files && input.files[0];
    const st = document.getElementById('backupStatus');
    if (!file) return;
    const reader = new FileReader();
    reader.onload = () => {
      let parsed = null;
      try { parsed = JSON.parse(reader.result); } catch (e){ /* handled below */ }
      if (!parsed || parsed.app !== 'TeacherBuddy' || !parsed.data || typeof parsed.data !== 'object'){
        if (st) st.textContent = 'That file isn\'t a TeacherBuddy backup.';
        input.value = '';
        return;
      }
      if (!confirm('Replace the TeacherBuddy data in this browser with this backup from ' + (parsed.exportedAt || 'an earlier date') + '?')){ input.value = ''; return; }
      try {
        Object.keys(parsed.data).forEach(k => { if (k.indexOf('tbanon_') === 0) localStorage.setItem(k, String(parsed.data[k])); });
      } catch (e){ if (st) st.textContent = 'Couldn\'t restore: this browser blocked storage.'; return; }
      location.reload();
    };
    reader.readAsText(file);
  }

