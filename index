      }
      // interruptions that were kept as real activity, with a way to join
      const kept = (tl && Array.isArray(tl.merges)) ? tl.merges.filter(m => !m.accepted) : [];
      if (kept.length){
        const h = document.createElement('div');
        h.className = 'field-label';
        h.style.margin = '12px 0 4px';
        h.textContent = 'Kept separate';
        body.appendChild(h);
        kept.forEach(m => {
          const j = document.createElement('div');
          j.className = 'joined-note';
          j.innerHTML = (m.text ? '"' + escapeHtml(m.text) + '"' : 'A short sound') + ' at ' + escapeHtml(m.at || '?') + ' <span>' + escapeHtml(m.reason || 'looked like real activity') + '</span> ';
          const btn = document.createElement('button');
          btn.className = 'edit-link'; btn.textContent = 'It was just an interruption, join';
          btn.onclick = () => toggleMerge(currentDay, m.id, true);
