    });
  }
  function saveGapAnswer(key, q, text, skipped){
    if (!skipped && !text) return;
    const source = dictationUsed['gapAns_' + key] ? 'voice' : 'typed';
    stopDictation();
    dictationUsed['gapAns_' + key] = false;
    const w = loadWeekData();
    if (!w.gapReflections || typeof w.gapReflections !== 'object') w.gapReflections = {};
    w.gapReflections[key] = skipped ? { q, a: '', skipped: true, at: stampNow() } : { q, a: text, source, at: stampNow() };
    saveWeekData(w);
    renderGapReflections();
  }
  function stressTableHtml(w, forPrint){
    let head = '<tr><th></th>', st = '<tr><td>Stress (1–5)</td>', hrs = '<tr><td>Work hours at school</td>';
    DAYS.forEach(d => {
      const t = computeDayTime(w[d]);
      const work = (t.face + t.prep + t.wellbeing + t.outside) / 60;
      head += '<th>' + DAY_LABELS_FULL[d].slice(0, 3) + '</th>';
      st += '<td>' + (w[d].stress ? escapeHtml(String(w[d].stress.value)) : '—') + '</td>';
      hrs += '<td>' + (work > 0 ? fmtHrs(work) : '—') + '</td>';
    });
    return '<table' + (forPrint ? '' : ' class="stress-table"') + '>' + head + '</tr>' + st + '</tr>' + hrs + '</tr></table>';
  }
  function coachFlags(w){
    const out = [];
    DAYS.forEach(d => {
      const g = w[d].guided;
      if (g && g.summary && (g.summary.rating === 'partly' || g.summary.rating === 'missed')){
        out.push({ type: 'reflection', day: d, dayLabel: DAY_LABELS_FULL[d], rating: g.summary.rating, summary: g.summary.text, revised: !!g.summary.revisedAfterClarifying });
      }
      const tl = w[d].timeline;
      const tr = tl && tl.teachingReview;
      if (tr && (tr.rating === 'partly' || tr.rating === 'missed')){
        out.push({ type: 'teaching', day: d, dayLabel: DAY_LABELS_FULL[d], rating: tr.rating,
          summary: (tl.teachingSessions || []).map((x, i) => 'Session ' + (i + 1) + ' (' + x.start + '–' + x.end + '): ' + x.summary).join(' '),
          revised: !!tr.revisedAfterClarifying });
      }
    });
    return out;
  }
  function guidedAnswerCount(day){
    const g = day.guided;
    if (!g || !Array.isArray(g.questions)) return 0;
    return g.questions.filter(x => x.a).length + (g.clarify && g.clarify.a ? 1 : 0) + (g.closing && g.closing.a ? 1 : 0);
  }

