<title>TeacherBuddy (anonymous demo)</title>
<style>
  :root{
    --accent:#04204A;          /* logo navy */
    --accent-ink:#021838;
    --accent-soft:#E4EBF6;
    --brand-blue:#0760E2;      /* logo blue (graduation cap) */
    --brand-grey:#8A94A6;      /* logo grey (speech dots) */
    --bg:#FAFAFB;
    --surface:#FFFFFF;
    --surface-2:#F2F3F5;
    --text:#14171F;
    --text-muted:#5E6A80;
    --border:#E1E5EC;
    --good:#04204A;
    --warn:#A6742E;
    --warn-soft:#F3E9D8;
    --critical:#A5473B;
    --critical-soft:#F3E1DD;
    --shadow: 0 1px 2px rgba(20,23,31,0.05);
    --sticky-header-h: 0px; /* set from JS to the real rendered height of .wizard-header, so .tab-switch docks right under it instead of behind it */
  }
  @media (prefers-color-scheme: dark){
    :root:not([data-theme="light"]){
      --accent:#8CA2D2;
      --accent-ink:#CBD8ED;
      --accent-soft:#1E2A42;
      --brand-blue:#5C9BFF;
      --brand-grey:#8A94A6;
      --bg:#0F1115;
      --surface:#171A21;
      --surface-2:#1E222B;
      --text:#EDEEF2;
      --text-muted:#8B93A3;
      --border:#2A2F3A;
      --good:#8CA2D2;
      --warn:#D8A85E;
      --warn-soft:#3A2E19;
      --critical:#D98479;
      --critical-soft:#3B241E;
      --shadow: 0 1px 2px rgba(0,0,0,.4);
    }
  }
  :root[data-theme="dark"]{
    --accent:#8CA2D2;
    --accent-ink:#CBD8ED;
    --accent-soft:#1E2A42;
    --brand-blue:#5C9BFF;
    --brand-grey:#8A94A6;
    --bg:#0F1115;
    --surface:#171A21;
    --surface-2:#1E222B;
    --text:#EDEEF2;
    --text-muted:#8B93A3;
    --border:#2A2F3A;
    --good:#8CA2D2;
    --warn:#D8A85E;
    --warn-soft:#3A2E19;
    --critical:#D98479;
    --critical-soft:#3B241E;
    --shadow: 0 1px 2px rgba(0,0,0,.4);
  }

  *{box-sizing:border-box;}
  body{
    background:var(--bg);
    color:var(--text);
    font-family:"Helvetica Neue", Helvetica, Arial, "Segoe UI", sans-serif;
    line-height:1.5;
    -webkit-font-smoothing:antialiased;
  }
  h1,h2,h3{
    font-family:"Helvetica Neue", Helvetica, Arial, sans-serif;
    font-weight:700;
    letter-spacing:-0.015em;
    text-wrap:balance;
    color:var(--text);
  }
  .mono, .num{ font-family:ui-monospace, "SF Mono", "Consolas", "Menlo", monospace; font-variant-numeric:tabular-nums; }
  button{ font:inherit; }
  a{ color:var(--brand-blue); }
  :focus-visible{ outline:2px solid var(--brand-blue); outline-offset:2px; }

  .wizard{ max-width:720px; margin:0 auto; padding:0 20px 64px; }

  .wizard-header{ padding:22px 0 16px; position:sticky; top:env(safe-area-inset-top, 0px); background:var(--bg); z-index:5; }
  .wizard-top{ display:flex; align-items:center; justify-content:space-between; gap:12px; margin-bottom:14px; }
  .brand{ display:flex; align-items:center; gap:9px; }
  .brand-logo{ height:34px; width:auto; flex:none; display:block; }
  .brand-logo-dark{ display:none; }
  @media (prefers-color-scheme: dark){
    :root:not([data-theme="light"]) .brand-logo-light{ display:none; }
    :root:not([data-theme="light"]) .brand-logo-dark{ display:block; }
  }
  :root[data-theme="dark"] .brand-logo-light{ display:none; }
  :root[data-theme="dark"] .brand-logo-dark{ display:block; }
  .brand-name{ font-size:18px; letter-spacing:-0.01em; line-height:1; }
  .brand-name .bn-light{ font-weight:300; color:var(--accent-ink); }
  .brand-name .bn-bold{ font-weight:700; color:var(--text); }
  .hero-logo{ display:block; width:92px; height:92px; margin:0 auto 6px; border-radius:50%; background:#fff; }
  .step-label{ font-size:12px; color:var(--text-muted); font-weight:600; }
  .progress-track{ height:3px; background:var(--border); border-radius:999px; overflow:hidden; }
  .progress-fill{ height:100%; background:var(--brand-blue); border-radius:999px; transition:width .35s ease; width:25%; }

  .day-strip{ display:flex; gap:6px; flex-wrap:wrap; align-items:center; }
  .day-pill{
    border:1px solid var(--border); background:var(--surface); color:var(--text-muted);
    border-radius:8px; padding:6px 12px; font-size:12.5px; font-weight:600; cursor:pointer; flex:none;
  }
  .day-pill:hover{ background:var(--surface-2); }
  .day-pill.active{ background:var(--accent); border-color:var(--accent); color:var(--surface); }
  .day-pill.weekly{ margin-left:8px; }
  .day-divider{ width:1px; height:18px; background:var(--border); margin:0 2px; flex:none; }

  main.wizard-main{ padding-top:6px; }
  .page{ }
  .eyebrow{ font-size:11.5px; font-weight:700; letter-spacing:.08em; text-transform:uppercase; color:var(--brand-blue); }
  .page h1{ font-size:25px; margin:5px 0 2px; }
  .page .sub{ color:var(--text-muted); font-size:13.5px; margin-bottom:20px; }

  .card{
    background:var(--surface); border:1px solid var(--border); border-radius:10px;
    padding:18px 20px; box-shadow:var(--shadow);
  }
  .card + .card{ margin-top:12px; }
  .card h3{ font-size:14.5px; margin:0 0 10px; font-weight:700; }
  .row{ display:flex; align-items:center; justify-content:space-between; gap:12px; }
  .stack{ display:flex; flex-direction:column; gap:10px; }

  .teacher-line{ display:flex; align-items:center; gap:10px; font-size:13.5px; color:var(--text-muted); margin-bottom:16px; flex-wrap:wrap; }
  .teacher-line .name{ color:var(--text); font-weight:700; }

  .text-input, select.text-input{
    width:100%; border:1px solid var(--border); border-radius:8px; padding:9px 12px;
    font:inherit; font-size:13.5px; color:var(--text); background:var(--surface-2);
  }
  .field-label{ font-size:11.5px; color:var(--text-muted); display:block; margin-bottom:4px; font-weight:600; text-transform:uppercase; letter-spacing:.03em; }

  .primary-btn{
    background:var(--accent); color:var(--surface); border:none;
    border-radius:8px; padding:11px 18px; font-weight:700; font-size:13.5px;
    cursor:pointer; display:inline-flex; align-items:center; gap:8px;
  }
  .primary-btn:active{ transform:translateY(1px); }
  .primary-btn[disabled]{ opacity:.45; cursor:default; }
  .ghost-btn{
    background:transparent; border:1px solid var(--border); color:var(--text);
    border-radius:8px; padding:10px 16px; font-size:13px; font-weight:600; cursor:pointer;
  }
  .ghost-btn:hover{ background:var(--surface-2); }
  .flag-btn{
    background:var(--accent); color:var(--surface); border:none;
    border-radius:8px; padding:9px 15px; font-weight:700; font-size:13px;
    cursor:pointer; display:inline-flex; align-items:center; gap:8px;
  }
  .flag-btn[disabled]{ opacity:.45; cursor:default; }
  .chip-btn{
    border:1px solid var(--border); background:transparent; border-radius:7px;
    padding:6px 10px; font-size:12px; cursor:pointer; color:var(--text); font-weight:600;
  }
  .chip-btn.primary{ background:var(--accent); border-color:var(--accent); color:var(--surface); }
  .chip-btn[disabled]{ opacity:.5; cursor:default; }
  .edit-link{ background:none; border:none; color:var(--brand-blue); font-size:12px; font-weight:700; cursor:pointer; padding:0; flex:none; }

  .wizard-nav{ display:flex; justify-content:space-between; align-items:center; margin-top:22px; }

  .intro-steps{ display:flex; flex-direction:column; gap:0; margin:16px 0 2px; }
  .intro-steps .step{
    display:flex; gap:12px; align-items:flex-start; padding:10px 0; border-bottom:1px solid var(--border); font-size:13.5px;
  }
  .intro-steps .step:last-child{ border-bottom:none; }
  .intro-steps .num{
    width:20px;height:20px;border-radius:5px; background:var(--surface-2); color:var(--text-muted);
    display:flex; align-items:center; justify-content:center; font-size:11px; font-weight:700; flex:none;
  }
  .intro-steps .txt strong{ display:block; margin-bottom:2px; }
  .intro-steps .txt span{ color:var(--text-muted); }

  .wellbeing-row{ display:flex; gap:8px; flex-wrap:wrap; }
  .wellbeing-chip{
    border:1px solid var(--border); background:var(--surface); border-radius:8px;
    padding:9px 14px; font-size:13px; font-weight:600; cursor:pointer; color:var(--text);
  }
  .wellbeing-chip:hover{ background:var(--surface-2); }
  .wellbeing-chip.selected{ background:var(--accent-soft); border-color:var(--accent); color:var(--accent-ink); }

  .alloc-row{ display:flex; align-items:center; justify-content:space-between; gap:14px; padding:12px 0; border-bottom:1px solid var(--border); font-size:13.5px; }
  .alloc-row:last-child{ border-bottom:none; }
  .alloc-row select{ width:auto; min-width:100px; flex:none; }
  .alloc-q{ font-weight:600; }
  .alloc-hint{ font-size:12px; color:var(--text-muted); margin-top:2px; font-weight:400; }


  .success-banner{
    display:none; align-items:center; gap:8px; background:var(--accent-soft); color:var(--accent-ink);
    border-radius:8px; padding:10px 14px; font-size:13px; font-weight:600; margin-top:14px;
  }
  .success-banner.show{ display:flex; }

  .consent-row{
    display:flex; gap:10px; align-items:flex-start; font-size:12.5px; color:var(--text-muted); margin-top:16px;
  }
  .consent-row input{ margin-top:3px; flex:none; }

  .ai-summary-list-title{ font-size:11.5px; font-weight:700; color:var(--text-muted); text-transform:uppercase; letter-spacing:.03em; margin:14px 0 2px; }
  .ai-summary-list-title:first-child{ margin-top:4px; }
  .ach-item, .anec-item{ display:flex; gap:10px; align-items:flex-start; font-size:13.5px; padding:9px 0; border-bottom:1px solid var(--border); }
  .ach-item:last-child, .anec-item:last-child{ border-bottom:none; }
  .ach-item .dot{ width:6px;height:6px;border-radius:50%; background:var(--good); margin-top:7px; flex:none; }
  .ach-item .dot.lens{ background:var(--accent); }
  .growth-lens-note{ font-size:12.5px; line-height:1.55; color:var(--text-muted); margin:2px 0 0; }
  .anec-item{ flex-direction:column; gap:6px; }
  .anec-item .anec-row{ display:flex; gap:10px; align-items:flex-start; justify-content:space-between; width:100%; }
  .anec-item .txt{ flex:1; }

  .idle-bar{ display:flex; height:10px; border-radius:6px; overflow:hidden; border:1px solid var(--border); }
  .idle-bar span{ height:100%; }
  .idle-legend{ display:flex; flex-wrap:wrap; gap:10px 16px; margin-top:12px; font-size:12px; }
  .idle-legend .item{ display:flex; align-items:center; gap:6px; color:var(--text-muted); }
  .idle-legend .sw{ width:8px;height:8px;border-radius:2px; }

  .confirm-row{
    display:flex; align-items:center; justify-content:space-between; gap:10px;
    padding:10px 0; border-bottom:1px solid var(--border); font-size:13.5px;
  }
  .confirm-row:last-child{ border-bottom:none; }
  .confirm-row .cause{ font-weight:700; }
  .confirm-row .dur{ color:var(--text-muted); font-size:12px; }
  .confirm-actions{ display:flex; gap:6px; flex:none; }
  .confirmed-badge{ font-size:11.5px; color:var(--good); font-weight:700; display:none; }

  .chat{ display:flex; flex-direction:column; gap:12px; }
  .bubble{ max-width:88%; padding:10px 13px; border-radius:10px; font-size:13.5px; }
  .bubble.bot{ background:var(--surface-2); align-self:flex-start; border-bottom-left-radius:3px; }
  .bubble.me{ background:var(--accent); color:var(--surface); align-self:flex-end; border-bottom-right-radius:3px; }
  .bubble .stamp{ display:block; margin-top:6px; font-size:10.5px; opacity:.65; }
  .reply-row{ display:flex; gap:8px; margin-top:4px; flex-wrap:wrap; }

  .edit-textarea{
    width:100%; min-height:64px; border:1px solid var(--border); border-radius:8px;
    padding:10px 12px; font:inherit; font-size:13.5px; color:var(--text); background:var(--surface-2);
    resize:vertical; margin-top:8px;
  }
  .edited-badge{
    display:inline-flex; align-items:center; gap:5px; font-size:11px; font-weight:700;
    color:var(--warn); background:var(--warn-soft); padding:3px 9px; border-radius:6px; margin-top:8px;
  }
  .dialog{
    margin-top:10px; padding:12px 14px; border-radius:8px; background:var(--surface-2);
    border:1px solid var(--border); font-size:13px; display:none;
  }
  .dialog.show{ display:block; }
  .dialog .actions{ display:flex; gap:8px; margin-top:10px; }

  .compare{ display:flex; flex-direction:column; gap:18px; }
  .metric-label{ display:flex; justify-content:space-between; font-size:12.5px; font-weight:700; margin-bottom:8px; }
  .bars{ display:flex; align-items:flex-end; gap:18px; height:90px; }
  .bar-group{ display:flex; flex-direction:column; align-items:center; gap:6px; flex:1; height:100%; justify-content:flex-end; }
  .bar-group .bar{ width:100%; max-width:52px; border-radius:4px 4px 2px 2px; position:relative; }
  .bar-group .val{ font-size:12px; font-weight:700; }
  .bar-group .lbl{ font-size:11px; color:var(--text-muted); }
  .bar.today{ background:var(--accent); }
  .bar.yesterday{ background:var(--border); }

  .week-block{ padding:10px 0; border-bottom:1px solid var(--border); }
  .week-block:last-child{ border-bottom:none; }
  .week-block .count{ font-size:20px; font-weight:700; color:var(--accent-ink); }
  .week-block .desc{ font-size:12.5px; color:var(--text-muted); margin-top:2px; }
  .prep-note{
    margin-top:16px; padding:11px 14px; border-radius:8px; background:var(--accent-soft);
    color:var(--accent-ink); font-size:12px;
  }

  .record-cta{ display:flex; flex-direction:column; align-items:center; text-align:center; gap:10px; padding:26px 24px; }
  .record-cta-top{ display:flex; flex-direction:column; align-items:center; gap:10px; }
  .record-big-btn{
    background:var(--accent); color:var(--surface); border:none; border-radius:999px;
    padding:16px 34px; font-weight:700; font-size:16px; cursor:pointer;
    display:inline-flex; align-items:center; gap:10px; letter-spacing:.01em;
  }
  .record-big-btn:active{ transform:translateY(1px); }
  .record-big-btn.recording{ background:var(--critical); }
  .record-dot{ width:11px; height:11px; border-radius:50%; background:var(--surface); opacity:.85; flex:none; }
  .record-dot.active{ animation:recpulse 1.1s ease-in-out infinite; }
  @keyframes recpulse{ 0%,100%{opacity:1} 50%{opacity:.35} }
  @media (prefers-reduced-motion: reduce){ .record-dot.active{ animation:none; } }
  .record-timer{ font-size:15px; color:var(--text-muted); }
  .record-guidance{ margin:4px 0 0; font-size:12.5px; color:var(--text-muted); max-width:440px; }

  /* Indeterminate progress bar: there's no real percentage to report for a
     single backend call, so this is an honest "still working" animation,
     not a fake completion count. Used while the AI summary request
     is in flight (fires automatically on submitting a reflection, as of v3.15). */
  .progress-track{
    width:100%; height:6px; border-radius:999px; overflow:hidden;
    background:var(--surface-2); margin-top:2px;
  }
  .progress-fill{
    width:40%; height:100%; border-radius:999px; background:var(--accent);
    animation:progressSlide 1.3s ease-in-out infinite;
  }
  @keyframes progressSlide{
    0%{ transform:translateX(-100%); }
    100%{ transform:translateX(250%); }
  }
  @media (prefers-reduced-motion: reduce){
    .progress-fill{ animation:none; width:65%; opacity:.7; }
  }

  .tab-switch{
    display:flex; gap:4px; background:var(--surface-2); border-radius:9px; padding:3px; margin-bottom:18px; width:fit-content;
    /* Docks just under the already-sticky header (Diagnostics/version row + the
       Mon–Fri/Weekly day strip) so which of Live the Day / Reflection you're on
       stays visible while you scroll down a long day's cards or chat. */
    position:sticky; top:calc(var(--sticky-header-h, 0px) + 10px); z-index:4;
    box-shadow:var(--shadow);
  }
  .tab-btn{
    border:none; background:transparent; color:var(--text-muted); font-size:13px; font-weight:600;
    padding:8px 16px; border-radius:7px; cursor:pointer;
  }
  .tab-btn.active{ background:var(--surface); color:var(--text); box-shadow:var(--shadow); }

  [hidden]{ display:none !important; }

  .version-btn{
    font-size:11px; font-weight:700; color:var(--text-muted); background:var(--surface-2);
    border:1px solid var(--border); border-radius:7px; padding:3px 10px; cursor:pointer; flex:none;
  }
  .version-btn:hover{ background:var(--border); }
  .modal-overlay{
    position:fixed; inset:0; background:rgba(15,17,21,.5); display:flex; align-items:center;
    justify-content:center; padding:20px; z-index:50;
  }
  .modal-overlay[hidden]{ display:none; }
  .modal-card{
    background:var(--surface); border-radius:10px; max-width:440px; width:100%; padding:22px 24px;
    box-shadow:var(--shadow); max-height:80vh; overflow-y:auto; position:relative; border:1px solid var(--border);
  }
  .modal-card h3{ margin:0 0 4px; font-size:16px; }
  .modal-card .close-x{
    position:absolute; top:16px; right:18px; background:none; border:none; font-size:18px;
    cursor:pointer; color:var(--text-muted); line-height:1;
  }
  .current-build{ font-size:12px; color:var(--text-muted); margin-bottom:14px; }
  .current-build strong{ color:var(--text); }
  .version-entry{ padding:10px 0; border-bottom:1px solid var(--border); font-size:13px; }
  .version-entry:last-child{ border-bottom:none; }
  .version-entry .tag{
    font-family:ui-monospace, monospace; font-size:11px; font-weight:700; color:var(--accent-ink);
    background:var(--accent-soft); padding:2px 7px; border-radius:5px; margin-right:6px;
  }
  .version-entry .date{ font-size:11px; color:var(--text-muted); }
  .version-entry p{ margin:6px 0 0; color:var(--text-muted); }

  .field-error{
    margin-top:10px; padding:9px 12px; border-radius:8px; background:var(--critical-soft);
    color:var(--critical); font-size:12.5px; font-weight:500;
  }
  .empty-state{ font-size:13px; color:var(--text-muted); padding:6px 0; line-height:1.55; }
  .bubble.me audio{ height:32px; max-width:100%; }

  .live-transcript{
    max-height:220px; overflow-y:auto; font-size:13px; line-height:1.65;
    background:var(--surface-2); border:1px solid var(--border); border-radius:8px;
    padding:12px 14px; white-space:pre-wrap;
  }
  .live-transcript .interim{ color:var(--text-muted); font-style:italic; }
  .rec-status-line{ font-size:12px; color:var(--text-muted); margin-top:10px; display:flex; align-items:center; gap:7px; flex-wrap:wrap; }
  .rec-status-dot{ width:7px;height:7px;border-radius:50%; background:var(--border); flex:none; }
  .rec-status-dot.live{ background:var(--good); animation:recpulse 1.1s ease-in-out infinite; }
  .auto-item{ display:flex; gap:10px; align-items:flex-start; font-size:13.5px; padding:9px 0; border-bottom:1px solid var(--border); }
  .auto-item:last-child{ border-bottom:none; }
  .auto-item .dot{ width:6px;height:6px;border-radius:50%; margin-top:7px; flex:none; }
  .auto-item.achievement .dot{ background:var(--good); }
  .auto-item.anecdote .dot{ background:var(--warn); }
  .auto-item .body{ flex:1; }
  .auto-item .meta{ font-size:11.5px; color:var(--text-muted); margin-top:2px; }
  .auto-item .remove-btn{ background:none; border:none; color:var(--text-muted); cursor:pointer; font-size:13px; flex:none; padding:2px 4px; line-height:1; }
  .auto-item .remove-btn:hover{ color:var(--critical); }
  .idle-item{ display:flex; justify-content:space-between; font-size:13.5px; padding:8px 0; border-bottom:1px solid var(--border); }
  .idle-item:last-child{ border-bottom:none; }
  .idle-item .dur{ color:var(--text-muted); font-size:12px; }

  .incident-item{ display:flex; flex-direction:column; gap:6px; font-size:13.5px; padding:10px 0; border-bottom:1px solid var(--border); }
  .incident-item:last-child{ border-bottom:none; }
  .incident-item .inc-head{ display:flex; gap:10px; align-items:flex-start; }
