      html += '<p class="wt-note">No setup estimates in the new categories yet.' + (keys.length ? ' Your earlier answers (older format): ' + keys.map(k => escapeHtml((LEGACY_ALLOC_LABELS[k] || k) + ' ' + wt.legacy[k])).join(', ') + '.' : '') + ' <button class="edit-link" onclick="editEstimates()">Add my estimates →</button></p>';
