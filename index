  // silently doing nothing.
  async function getMic(errorElId){
    const el = document.getElementById(errorElId);
    if (el) el.hidden = true;
    if (!navigator.mediaDevices || !navigator.mediaDevices.getUserMedia){
      if (el){ el.textContent = 'This browser (or this embedded preview) doesn\'t expose microphone access. Try opening this page directly in a full browser tab.'; el.hidden = false; }
      return null;
    }
    try {
      return await navigator.mediaDevices.getUserMedia({ audio: true });
    } catch (err){
      if (el){
        if (err && err.name === 'NotAllowedError'){
          el.textContent = 'Microphone permission was denied. If you already allowed it in your browser\'s site settings, reload this page — permission changes often need a refresh. If this page is inside a chat preview or embedded frame, open it in its own full browser tab instead: embedded previews commonly block the microphone no matter what you allow at the browser level.';
        } else if (err && err.name === 'NotFoundError'){
          el.textContent = 'No microphone was found on this device.';
        } else {
          el.textContent = 'Couldn\'t start recording (' + (err && err.name ? err.name : 'an unknown error') + '). Try the "Enable microphone" button above, or reload the page.';
        }
        el.hidden = false;
