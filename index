      mi.setAttribute('aria-label', 'Minutes');
      const ab = document.createElement('button');
      ab.className = 'chip-btn'; ab.textContent = '+ Add';
      ab.onclick = () => addAfterHoursEntry(sel.value, mi.value);
      add.appendChild(sel); add.appendChild(mi); add.appendChild(document.createTextNode(' min ')); add.appendChild(ab);
      box.appendChild(add);
      const redo = document.createElement('button');
      redo.className = 'edit-link';
      redo.style.marginTop = '10px';
      redo.textContent = 'Change my answer';
      redo.onclick = reopenAfterHours;
      box.appendChild(redo);
    }
    document.getElementById('weeklyResults').hidden = !done;
    if (done) renderWeeklySummary();
  }
  function saveAfterHours(patch){
    const w = loadWeekData();
    w.afterHours = Object.assign({ answer: '', source: 'typed', entries: [], done: false, skipped: false, at: '' }, getAfterHours(w) || {}, patch);
    saveWeekData(w);
  }
  function cleanEntries(list){
    return (Array.isArray(list) ? list : []).map(e => ({
      cat: WORK_CATS.includes(e && e.category) ? e.category : (WORK_CATS.includes(e && e.cat) ? e.cat : 'outside'),
      activity: (e && typeof e.activity === 'string') ? e.activity.slice(0, 80) : '',
      minutes: Math.max(0, Math.min(1440, Math.round(Number(e && e.minutes) || 0)))
    })).filter(e => e.minutes > 0 || e.activity);
  }
  async function sendAfterHours(){
    const ta = document.getElementById('afterHoursAnswer');
    const text = ta.value.trim();
    if (!text) return;
    const source = dictationUsed.afterHoursAnswer ? 'voice' : 'typed';
    stopDictation();
