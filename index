  // Minutes per category for one day. Quiet blocks count wherever the teacher
  // tagged them. Talk time is split by the activity blocks from "Read my day"
  // when there are any, otherwise it all counts as face-to-face teaching.
  function computeDayTime(day){
    const out = { face: 0, prep: 0, wellbeing: 0, outside: 0, break: 0, untagged: 0, recorded: 0 };
    let recorded = (day.recordedSeconds || 0) / 60;
    if (recorded < 1) recorded = Math.max(recorded, estimateMinutesFromStamps(day));
    out.recorded = recorded;
    let idleTotal = 0;
    quietBlocksFor(day).forEach(b => {
      const m = Number(b.minutes) || 0;
