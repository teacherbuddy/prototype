  }
  function logReply(day, text){
    const w = loadWeekData();
    w[day].replies.push({ text: text, at: stampNow() });
    saveWeekData(w);
  }
  // Saves every finalized line of the live transcript as it comes in — not just
  // the keyword-flagged snippets. Today this is write-only (nothing reads it
  // back yet); it exists so a day recorded now stays eligible for a richer,
  // contextual re-analysis later instead of the raw transcript being lost the
  // moment the tab closes.
  function logTranscriptLine(day, text){
    if (!text) return;
    const w = loadWeekData();
    w[day].transcript.push({ text: text, at: stampNow(), ts: Date.now() });
    saveWeekData(w);
  }
  // v4.4: lines the recognizer wasn't sure about, or that don't look like English,
  // are kept here (on this device only) instead of in the transcript. They are not
  // shown in the live transcript, not keyword-tagged, and not sent to the AI summary.
  function logHiddenLine(day, text, reason, conf){
    if (!text) return;
    const w = loadWeekData();
    if (!w[day]) return;
    w[day].hiddenLines.push({ text: text, at: stampNow(), ts: Date.now(), reason: reason, conf: conf });
    if (w[day].hiddenLines.length > 500) w[day].hiddenLines.shift();
    saveWeekData(w);
  }

  // ---------- Weekly summary + coach export (built from real week data above) ----------
  // Pre-v4 setup answers (range strings), shown only for reference.
  const LEGACY_ALLOC_LABELS = { teaching: 'Teaching', planning: 'Planning & prep', grading: 'Grading', parentComm: 'Parent communication', meetings: 'Meetings', admin: 'Admin / paperwork' };
  const MOOD_LABELS = { great: '🙂 Great', okay: '😐 Okay', struggling: '😣 Struggling' };
  // What kind of support would help — an optional tag the teacher can add
  // while explaining a flagged "needs a follow-up" moment, so the weekly
  // report can surface what's actually being asked for, not just a log of
  // what happened.
  const SUPPORT_LABELS = {
    classroom: 'Classroom management strategy',
    time: 'More planning or prep time',
    resource: 'A resource or tech issue — needs admin',
    talk: 'Just want to talk it through',
    handled: 'No support needed — handled it herself'
  };
  // Categories tagged here are NOT a request for anything — they're the opposite,
  // the teacher explicitly saying she didn't need help with this one. Kept out of
  // "Support requested this week" (computeSupportRequests below) so a coach reading
  // the weekly report never mistakes "I handled it myself" for an open ask.
  const SELF_HANDLED_CATEGORY = 'handled';

  // A starting suggestion for which kind of support fits each auto-flagged
  // incident type — pre-highlighted (not forced) when the teacher opens
  // "Explain this", since the incident's own category is a reasonable first
  // guess at what to tag it. The teacher can still pick a different chip or
  // clear the selection entirely.
  // v4.3: every kind of flagged moment belongs to a Thompson et al. (2024)
  // category and activity.
  const INCIDENT_THOMPSON = {
    'Tool / technical trouble': { cat: 'face', activity: 'Managing resources' },
    'Possible student conflict': { cat: 'face', activity: 'Significant behavioural interruptions' }
  };
  function incidentThompson(inc){
    if (inc && inc.category && TIME_CATEGORIES[inc.category]) return { cat: inc.category, activity: inc.activity || '' };
    return INCIDENT_THOMPSON[inc && inc.label] || null;
  }
  function incidentThompsonLabel(inc){
    const t = incidentThompson(inc);
    return t ? catLabel(t.cat) + (t.activity ? ' · ' + t.activity : '') : '';
  }
  const SUPPORT_SUGGESTION_BY_LABEL = {
    'Tool / technical trouble': 'resource',
    'Possible student conflict': 'classroom',
  };

  function computeSupportRequests(w){
    const out = [];
    DAYS.forEach(d => {
      (w[d].incidents || []).forEach(inc => {
        if (inc.context && inc.context.support && inc.context.support !== SELF_HANDLED_CATEGORY){
          out.push({ day: d, dayLabel: DAY_LABELS_FULL[d], incidentLabel: inc.label, category: inc.context.support, categoryLabel: SUPPORT_LABELS[inc.context.support] || inc.context.support, text: inc.context.text, at: inc.context.at });
        }
      });
    });
    return out;
  }

  // Count of flagged moments the teacher explicitly marked as self-handled —
  // kept separate from computeSupportRequests() above since this is the opposite
  // signal (no help needed, not a request). Surfaced as a small positive count
  // rather than folded into the "Support requested" list.
  function computeSelfHandledCount(w){
    let n = 0;
    DAYS.forEach(d => {
      (w[d].incidents || []).forEach(inc => {
        if (inc.context && inc.context.support === SELF_HANDLED_CATEGORY) n++;
      });
    });
    return n;
  }

  // Count of flagged entries that actually crossed the pattern threshold
  // (a clustered label repeating enough times in a day to be flagged, or any
  // non-clustered incident, which always counts) — kept separate from a
  // quiet, below-threshold cluster so weekly/PDF reporting can call out a
  // recurring pattern specifically, the way a single one-off moment doesn't
  // need calling out.
  function computePatternCount(w){
    let n = 0;
    DAYS.forEach(d => {
      (w[d].incidents || []).forEach(inc => {
        if (inc.clustered && inc.pattern) n++;
      });
    });
    return n;
  }

  // ---------- v4.0: after-hours work (asked first on Week Reflection) ----------
  function getAfterHours(w){ return (w && w.afterHours && typeof w.afterHours === 'object') ? w.afterHours : null; }
  function renderAfterHours(){
    const w = loadWeekData();
    const ah = getAfterHours(w);
    const done = !!(ah && ah.done);
    const chat = document.getElementById('afterHoursChat');
    chat.innerHTML = '';
    if (done){
      chat.appendChild(botBubble('Did you do any work outside school hours this week?', 'TeacherBuddy'));
      chat.appendChild(buildMeBubble(ah.skipped ? 'Nothing outside school hours this week.' : ah.answer, (ah.source === 'voice' ? 'Spoken' : 'Typed') + ' · ' + (ah.at || '')));
    }
    document.getElementById('afterHoursComposer').hidden = done;
    const box = document.getElementById('afterHoursEntries');
    box.innerHTML = '';
    if (done){
      const head = document.createElement('div');
      head.className = 'field-label';
      head.style.margin = '12px 0 4px';
      head.textContent = 'Sorted into time categories (fix anything that\'s off)';
      box.appendChild(head);
      const entries = ah.entries || [];
      if (!entries.length){
        const e = document.createElement('div');
        e.className = 'empty-state';
        e.textContent = ah.skipped ? 'No after-hours work recorded.' : 'Nothing to sort yet. Add an entry below if something was missed.';
        box.appendChild(e);
      }
      entries.forEach((en, i) => {
        const row = document.createElement('div');
        row.className = 'ah-row';
        row.innerHTML = '<div class="ah-what"><strong>' + escapeHtml(en.activity || catLabel(en.cat)) + '</strong><span>' + escapeHtml(catLabel(en.cat)) + '</span></div>';
        const mins = document.createElement('span');
        mins.className = 'hrs-wrap';
