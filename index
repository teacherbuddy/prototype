    err.hidden = true;
    document.getElementById('afterHoursComposer').hidden = true;
    document.getElementById('afterHoursLoading').hidden = false;
    let entries = [];
    try {
      const data = await callWorker({ mode: 'afterHours', answer: text });
      if (!Array.isArray(data.entries)) throw workerOutdatedError();
      entries = cleanEntries(data.entries);
      saveAfterHours({ answer: text, source, entries, done: true, skipped: false, at: stampNow() });
    } catch (e){
      // Keep the teacher's words even if sorting failed; they can add entries by hand.
      saveAfterHours({ answer: text, source, entries: [], done: true, skipped: false, at: stampNow() });
      err.textContent = ((e && e.message) || 'Could not reach the analysis service.') + ' Your answer is saved. Add the entries by hand below, or tap "Change my answer" to try again.';
      err.hidden = false;
    } finally {
      document.getElementById('afterHoursLoading').hidden = true;
      ta.value = '';
